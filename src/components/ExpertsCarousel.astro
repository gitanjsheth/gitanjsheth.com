---
/**
 * Infinite, swipeable, peeking EXPERTS carousel — same clone-free modulo engine
 * as TestimonialsCarousel, with its own class prefix (`ecar`) and root hook
 * (`data-ecarousel`) so the two carousels on the home page never cross-wire.
 *
 * Each card, top → bottom: 3:2 photo · name · role · "Read more" button that
 * jumps to that expert's anchored section on /experts (#<entry id>).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { localizePath, useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  items: CollectionEntry<"experts">[];
}
const { locale, items } = Astro.props;
const t = useTranslations(locale);

// The peeking carousel shows 3 cards + a 20% sliver of the next on each side.
// That needs 5 positions, so with a short bench (<5) we repeat it until there
// are enough cards to peek into. With ≥5 experts the peeks are already native.
let loop = items;
if (items.length > 0 && items.length < 5) {
  loop = [];
  while (loop.length < 5) loop = loop.concat(items);
}

const peopleImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/people/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);
function resolvePhoto(photo?: string) {
  if (!photo) return undefined;
  return peopleImages[`/src/assets/${photo}`]?.default;
}
function initialsOf(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? "")
    .join("");
}
const expertsPath = localizePath(locale, "experts");
---

<div class="ecar" data-ecarousel>
  <div class="ecar__stage" data-ecar-track role="group" aria-roledescription="carousel">
    {
      loop.map((e, i) => {
        const d = e.data;
        const photoImg = resolvePhoto(d.photo);
        return (
          <article class="ecar__card" data-ecar-card aria-label={`${i + 1} / ${loop.length}`} lang={locale}>
            <a class="ecar__media" href={`${expertsPath}#${e.id}`} aria-label={d.name}>
              {photoImg ? (
                <Image src={photoImg} alt={d.name} width={600} height={600} class="ecar__img" />
              ) : (
                <span class="ecar__img ecar__img--ph" aria-hidden="true">{initialsOf(d.name)}</span>
              )}
            </a>
            <h3 class="ecar__name">{d.name}</h3>
            {d.education && <p class="ecar__edu">{d.education[locale]}</p>}
            <p class="ecar__role">{d.domain[locale]}</p>
            <p class="ecar__brief">{d.blurb[locale]}</p>
            <a class="ecar__more btn btn-ghost" href={`${expertsPath}#${e.id}`}>
              {t("home.experts.readMore")}
            </a>
          </article>
        );
      })
    }
  </div>

  <button type="button" class="ecar__arrow ecar__arrow--prev" data-ecar-prev aria-label={t("testimonials.prev")}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button type="button" class="ecar__arrow ecar__arrow--next" data-ecar-next aria-label={t("testimonials.next")}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<style>
  .ecar {
    position: relative;
  }
  .ecar__stage {
    position: relative;
    width: 100%;
    overflow: hidden;
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .ecar__stage.is-ready { opacity: 1; }
  .ecar__stage.is-dragging { cursor: grabbing; user-select: none; }

  /* One continuous width instead of stepped breakpoints, so the card shrinks
     smoothly and never "jumps" size near 640px. The clamp is tuned so that at
     the ~1056px desktop stage it shows ~2.5 wide cards with a peek each side;
     on smaller stages fewer fit, continuously. Widened ~30% for the square
     photo + 3-line brief. */
  .ecar__card {
    position: absolute;
    top: 0;
    left: 50%;
    width: clamp(286px, 34.6%, 365px);
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--muted); /* content on a light card = Color 3 */
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    border-radius: 4px;
    padding: 1.2rem 1.2rem 1.4rem;
    margin: 0;
    opacity: 0.4;
    transition: opacity 300ms ease, border-color 300ms ease;
    will-change: transform;
  }
  .ecar__card.is-active {
    border-color: color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .ecar__media {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 3px;
    overflow: hidden;
    background: color-mix(in srgb, var(--ink) 6%, var(--paper));
  }
  .ecar__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ecar__img--ph {
    display: flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--ink) 45%, transparent);
    font-family: theme("fontFamily.display");
    font-size: 2rem;
    letter-spacing: 0.05em;
  }
  .ecar__name {
    margin-top: 1rem;
    font-size: 1.2rem;
  }
  .ecar__edu {
    margin-top: 0.35rem;
    font-size: clamp(0.875rem, 0.823rem + 0.22vw, 1rem); /* 14 -> 16, fluid */
    color: var(--muted);
  }
  .ecar__role {
    margin-top: 0.35rem;
    font-family: theme("fontFamily.mono");
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: clamp(0.875rem, 0.823rem + 0.22vw, 1rem); /* 14 -> 16, fluid */
    color: var(--gold);
  }
  .ecar__brief {
    margin-top: 0.75rem;
    font-size: clamp(1rem, 0.948rem + 0.22vw, 1.125rem); /* 16 -> 18, fluid */
    line-height: 1.5;
    color: var(--muted); /* content on a light card = Color 3 */
  }
  .ecar__more {
    margin-top: 1.1rem;
    align-self: center;
    padding: 0.55rem 1rem;
    font-size: 0.9rem;
  }

  .ecar__arrow {
    position: absolute;
    top: 38%;
    transform: translateY(-50%);
    width: 2.6rem;
    height: 2.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: 999px;
    box-shadow: 0 8px 24px -12px color-mix(in srgb, var(--ink) 40%, transparent);
    cursor: pointer;
    opacity: 0;
    transition: opacity 200ms ease, background-color 200ms ease;
    z-index: 20;
  }
  .ecar:hover .ecar__arrow { opacity: 1; }
  .ecar__arrow:focus-visible { opacity: 1; }
  .ecar__arrow:hover { background: var(--ivory); }
  .ecar__arrow--prev { left: 0.5rem; }
  .ecar__arrow--next { right: 0.5rem; }
  @media (hover: none) {
    .ecar__arrow { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-ecarousel]").forEach((root) => {
    const stage = root.querySelector<HTMLElement>("[data-ecar-track]");
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-ecar-card]"));
    const N = cards.length;
    if (!stage || N === 0) return;

    const GAP = 25;
    let step = 0;
    let cardHalf = 0;
    let stageHalf = 0;
    let pos = 0;
    let target = 0;
    let raf = 0;

    const mod = (a: number, m: number) => ((a % m) + m) % m;

    function measure() {
      const cw = cards[0].getBoundingClientRect().width;
      step = cw + GAP;
      cardHalf = cw / 2;
      stageHalf = stage.getBoundingClientRect().width / 2;
      let maxH = 0;
      cards.forEach((c) => (c.style.height = "auto"));
      cards.forEach((c) => (maxH = Math.max(maxH, c.getBoundingClientRect().height)));
      cards.forEach((c) => (c.style.height = `${maxH}px`));
      stage.style.height = `${maxH}px`;
    }

    function render() {
      for (let i = 0; i < N; i++) {
        let d = mod(i - pos, N);
        if (d > N / 2) d -= N;
        const card = cards[i];
        card.style.transform = `translateX(calc(-50% + ${d * step}px))`;
        const ad = Math.abs(d);
        card.classList.toggle("is-active", ad < 0.5);
        // Full opacity only while the whole card is inside the stage; the 20%
        // peeks that spill past the edge are dimmed.
        card.style.opacity = ad * step + cardHalf <= stageHalf + 1 ? "1" : "0.4";
        card.style.zIndex = String(N - Math.round(ad));
        card.style.visibility = ad > N / 2 - 0.001 ? "hidden" : "visible";
      }
    }

    function tick() {
      const diff = target - pos;
      if (Math.abs(diff) < 0.001) {
        pos = target = mod(target, N);
        render();
        raf = 0;
        return;
      }
      pos += diff * 0.2;
      render();
      raf = requestAnimationFrame(tick);
    }
    const animate = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    const go = (dir: number) => {
      target += dir;
      animate();
    };
    root.querySelector("[data-ecar-prev]")?.addEventListener("click", () => go(-1));
    root.querySelector("[data-ecar-next]")?.addEventListener("click", () => go(1));

    // Pointer / touch drag
    let dragging = false;
    let moved = false;
    let startX = 0;
    let startPos = 0;
    let pid = -1;
    stage.addEventListener("pointerdown", (e) => {
      dragging = true;
      moved = false;
      startX = e.clientX;
      startPos = pos;
      pid = e.pointerId;
      if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    });
    stage.addEventListener("pointermove", (e) => {
      if (!dragging || !step) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 6) {
        moved = true;
        stage.setPointerCapture(pid);
        stage.classList.add("is-dragging");
      }
      if (moved) {
        pos = startPos - dx / step;
        render();
      }
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      stage.classList.remove("is-dragging");
      if (moved) {
        target = Math.round(pos);
        animate();
      }
    };
    stage.addEventListener("pointerup", endDrag);
    stage.addEventListener("pointercancel", endDrag);
    // A drag on a card must not follow its Read-more link.
    stage.addEventListener("click", (e) => {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    measure();
    render();
    stage.classList.add("is-ready");
    window.addEventListener("load", () => {
      measure();
      render();
    });
    let rt: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(rt);
      rt = setTimeout(() => {
        measure();
        render();
      }, 100);
    });
  });
</script>
