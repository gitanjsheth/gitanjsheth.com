---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Logo from "./Logo.astro";
import { localizePath, useTranslations, type Locale } from "../i18n/utils";
import { sections } from "../config";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const nav = [
  { key: "ourStory", href: localizePath(locale, "our-story") },
  { key: "gitanj", href: localizePath(locale, "gitanj-sheth") },
  ...(sections.experts
    ? [{ key: "experts", href: localizePath(locale, "experts") }]
    : []),
  ...(sections.caseStudies
    ? [{ key: "caseStudies", href: localizePath(locale, "case-studies") }]
    : []),
  ...(sections.testimonials
    ? [{ key: "testimonials", href: localizePath(locale, "testimonials") }]
    : []),
  { key: "howWeEngage", href: localizePath(locale, "how-we-engage") },
  { key: "contact", href: localizePath(locale, "contact") },
];

// --- Group / associate companies (each is one legal entity + one or more
// brand logos that each link to their own site). -----------------------------
const brandImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/brands/*.{png,PNG,webp,jpg,jpeg}",
  { eager: true }
);
const logo = (file: string) => brandImages[`/src/assets/brands/${file}`]?.default;

type Company = { name: string; logos: { img?: ImageMetadata; href: string; alt: string }[] };

const parent: Company[] = [
  {
    name: "Swapna Srushti Horizon Pvt Ltd",
    logos: [{ img: logo("swapna-srushti.png"), href: "https://shethgroup1992.com/", alt: "Sheth Group 1992" }],
  },
];
const associates: Company[] = [
  {
    name: "Virgit Smart Solutions LLP",
    logos: [{ img: logo("parth-ai.png"), href: "https://parthaisolutions.com/", alt: "Parth AI Solutions" }],
  },
  {
    name: "Sheth Saga Pvt Ltd",
    logos: [
      { img: logo("realty-gateway.png"), href: "http://realtygateway.in/", alt: "Realty Gateway" },
      { img: logo("your-own-class.png"), href: "https://www.yourownclass.com/", alt: "Your Own Class" },
    ],
  },
];
---

<footer class="border-t border-ink/10">
  <div class="container-x py-14">
    <!-- Desktop: firm/tagline top-left, nav on the right (spanning), brands
         filling the space below the tagline beside the nav. Mobile: stacks in
         order firm/tagline -> nav -> brands -> copyright. -->
    <div class="footer-layout">
      <div class="footer-firm">
        <span class="inline-flex items-center gap-2.5">
          <Logo variant="ink" showText={false} />
          <span class="font-display font-semibold text-hlight" style="font-size:1.25rem;letter-spacing:-0.01em;">
            {t("site.firm")}
          </span>
        </span>
        <p class="mt-4 text-sm text-muted measure">{t("footer.tagline")}</p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <ul class="space-y-2">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-muted hover:text-hlight transition-colors duration-250">
                  {t(`nav.${item.key}`)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-brands">
        <div class="footer-brand-group">
          <h3 class="footer-brand-label">{t("footer.parentLabel")}</h3>
          <div class="footer-companies">
            {parent.map((c) => (
              <div class="footer-company footer-company--inline">
                <div class="footer-company__logos">
                  {c.logos.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener" class="footer-brand-logo" aria-label={c.name}>
                      {l.img ? <Image src={l.img} alt={l.alt} class="footer-brand-logo__img" /> : l.alt}
                    </a>
                  ))}
                </div>
                <p class="footer-company__name">{c.name}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="footer-brand-group">
          <h3 class="footer-brand-label">{t("footer.associatesLabel")}</h3>
          <div class="footer-companies">
            {associates.map((c) => (
              <div class="footer-company">
                <div class="footer-company__logos">
                  {c.logos.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener" class="footer-brand-logo" aria-label={c.name}>
                      {l.img ? <Image src={l.img} alt={l.alt} class="footer-brand-logo__img" /> : l.alt}
                    </a>
                  ))}
                </div>
                <p class="footer-company__name">{c.name}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <hr class="rule rule-gold mt-12 mb-6 opacity-60" />
    <p class="text-xs text-muted">
      &copy; {year} {t("site.firm")} &middot; {t("footer.rights")}
    </p>
  </div>
</footer>

<style>
  /* Below 768: firm/tagline -> nav -> brands, stacked at full/comfortable size
     (the stacked layout adapts on its own, so nothing shrinks here).
     >= 768: grid (firm top-left, nav on the right spanning, brands below), and
     EVERY piece — labels, names, logos, gaps — shrinks together as the row
     tightens toward 768, back to full size by ~1280. This keeps it side-by-side
     without sudden rearranging. */
  .footer-layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .footer-firm { order: 1; }
  .footer-nav { order: 2; }
  .footer-brands { order: 3; }

  /* Parent then Associate groups: left-aligned, wrapping when tight. */
  .footer-brands {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 3rem 5rem;
  }
  .footer-brand-label {
    font-family: theme("fontFamily.mono");
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--muted);
  }
  .footer-companies {
    margin-top: 1.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 4rem;
    align-items: flex-start;
  }
  .footer-company {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }
  /* Parent: logo beside a two-line name so the logo can be larger. */
  .footer-company--inline {
    flex-direction: row;
    align-items: center;
    gap: 1.25rem;
  }
  .footer-company__logos {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    min-height: 2.25rem;
  }
  .footer-company--inline .footer-company__logos { min-height: 0; }
  .footer-company__name {
    font-size: 0.9rem;
    color: var(--muted);
    text-align: center;
    line-height: 1.35;
  }
  .footer-company--inline .footer-company__name {
    text-align: left;
    max-width: 10rem;
    line-height: 1.7; /* wider gap between the two wrapped lines */
  }
  .footer-brand-logo {
    display: inline-flex;
    align-items: center;
    opacity: 0.85;
    transition: opacity 200ms ease;
  }
  .footer-brand-logo:hover,
  .footer-brand-logo:focus-visible { opacity: 1; }
  .footer-brand-logo__img {
    height: 2.25rem;
    width: auto;
    max-width: 11rem;
    object-fit: contain;
    display: block;
  }
  .footer-company--inline .footer-brand-logo__img {
    height: 3.5rem;
    max-width: 9rem;
  }

  @media (min-width: 768px) {
    .footer-layout {
      display: grid;
      /* col1 = content (firm/brands), col2 = nav, packed left so the nav sits
         just past the brands rather than at the far edge. */
      grid-template-columns: auto auto;
      grid-template-areas:
        "firm nav"
        "brands nav";
      justify-content: start;
      column-gap: clamp(2.5rem, 7vw, 7rem);
      row-gap: 3.25rem;
      align-items: start;
    }
    .footer-firm { grid-area: firm; }
    .footer-nav { grid-area: nav; }
    .footer-brands { grid-area: brands; }

    /* Shrink toward the 768 edge (24px logos, 12.8px labels, 12.5px names,
       tighter gaps), returning to full size by ~1280. */
    .footer-brands { column-gap: clamp(2rem, -2.5rem + 9.38vw, 5rem); }
    .footer-companies {
      margin-top: clamp(1.25rem, 0.35rem + 1.88vw, 1.85rem);
      column-gap: clamp(1.5rem, -2.25rem + 7.81vw, 4rem);
    }
    .footer-company__logos { gap: clamp(1rem, -0.13rem + 2.34vw, 1.75rem); }
    .footer-brand-label { font-size: clamp(0.8rem, 0.575rem + 0.47vw, 0.95rem); }
    .footer-company__name { font-size: clamp(0.78rem, 0.6rem + 0.38vw, 0.9rem); }
    .footer-company--inline .footer-company__name {
      max-width: clamp(8rem, 5rem + 6.25vw, 10rem);
    }
    .footer-brand-logo__img { height: clamp(1.5rem, 0.375rem + 2.34vw, 2.25rem); }
    .footer-company--inline .footer-brand-logo__img {
      height: clamp(2.25rem, 0.375rem + 3.91vw, 3.5rem);
    }
  }
</style>
