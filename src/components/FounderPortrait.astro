---
/**
 * Editorial portrait of Gitanj. Uses the real photo when it exists at
 * `src/assets/people/gitanj.{png,jpg,...}`; otherwise a labelled placeholder.
 *
 * IMPORTANT: we deliberately do NOT use <Image>/astro:assets here. That
 * pipeline re-encodes to WebP and downscales/compresses, which flattens the
 * look and discards transparency. Instead we import the asset and render it as
 * a plain <img> using its `.src` — Astro then just fingerprints and copies the
 * ORIGINAL file byte-for-byte (transparency + full resolution intact).
 */
import type { ImageMetadata } from "astro";

interface Props {
  alt: string;
  class?: string;
}
const { alt, class: className = "" } = Astro.props;

const candidates = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/people/gitanj.{png,jpg,jpeg,webp,avif,PNG,JPG,JPEG,WEBP,AVIF}",
  { eager: true }
);
const found = Object.values(candidates)[0]?.default;
---

<div class={`founder-portrait ${found ? "" : "founder-portrait--empty"} ${className}`}>
  {
    found ? (
      <img
        src={found.src}
        alt={alt}
        width={found.width}
        height={found.height}
        loading="eager"
        decoding="async"
        class="founder-portrait__img"
      />
    ) : (
      <div class="founder-portrait__placeholder" role="img" aria-label={alt}>
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
          <circle cx="12" cy="9" r="3.5" />
          <path d="M4.5 19.5a7.5 7.5 0 0115 0" stroke-linecap="round" />
        </svg>
        <span class="founder-portrait__label">Portrait — Gitanj Sheth</span>
        <span class="founder-portrait__hint">src/assets/people/gitanj.webp</span>
      </div>
    )
  }
</div>

<style>
  .founder-portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
  }
  /* Only the empty state gets a framed panel; a real (often transparent)
     portrait is shown as a clean cut-out with no background behind it. */
  .founder-portrait--empty {
    border-radius: 4px;
    overflow: hidden;
    background: color-mix(in srgb, var(--ink) 6%, var(--paper));
  }
  .founder-portrait__img {
    width: 100%;
    height: 100%;
    object-fit: contain; /* never crop the figure */
    object-position: right bottom;
    display: block;
  }
  .founder-portrait__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: color-mix(in srgb, var(--ink) 40%, transparent);
    border: 1px dashed color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: 4px;
  }
  .founder-portrait__label {
    font-family: theme("fontFamily.mono");
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.875rem;
  }
  .founder-portrait__hint {
    font-family: theme("fontFamily.mono");
    font-size: 0.62rem;
    opacity: 0.6;
  }
</style>
