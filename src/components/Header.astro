---
/**
 * Sticky, minimal header: wordmark left; nav; language switcher; Enquire button.
 * Collapses to a clean toggle menu on mobile. All interactivity is client JS
 * (works fine on static GitHub Pages).
 */
import Logo from "./Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { localizePath, useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  pagePath: string;
}
const { locale, pagePath } = Astro.props;
const t = useTranslations(locale);

const nav = [
  { key: "story", href: localizePath(locale, "home") + "#story", match: "" },
  { key: "services", href: localizePath(locale, "services"), match: "services" },
  { key: "caseStudies", href: localizePath(locale, "case-studies"), match: "case-studies" },
  { key: "testimonials", href: localizePath(locale, "testimonials"), match: "testimonials" },
  { key: "experts", href: localizePath(locale, "experts"), match: "experts" },
  { key: "howWeEngage", href: localizePath(locale, "how-we-engage"), match: "how-we-engage" },
  { key: "contact", href: localizePath(locale, "contact"), match: "contact" },
];

const isActive = (match: string) =>
  match !== "" && (pagePath === match || pagePath.startsWith(match + "/"));
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-ivory/90 backdrop-blur">
  <div class="container-x flex items-center justify-between gap-4 py-3">
    <a href={localizePath(locale, "home")} class="shrink-0" aria-label={t("site.name")}>
      <Logo variant="ink" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-6" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "link text-sm",
              isActive(item.match) ? "font-semibold" : "",
            ]}
            aria-current={isActive(item.match) ? "page" : undefined}
          >
            {t(`nav.${item.key}`)}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:flex items-center gap-4">
      <LanguageSwitcher locale={locale} pagePath={pagePath} />
      <a href={localizePath(locale, "contact") + "#enquire"} class="btn btn-primary">
        {t("nav.enquire")}
      </a>
    </div>

    <!-- Mobile toggle -->
    <button
      type="button"
      class="lg:hidden inline-flex items-center justify-center p-2"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
      aria-label={t("nav.openMenu")}
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" data-icon-open />
        <path d="M6 6l12 12M6 18L18 6" stroke-linecap="round" class="hidden" data-icon-close />
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-ink/10 bg-ivory" data-menu-panel>
    <nav class="container-x flex flex-col py-4" aria-label="Mobile">
      {
        nav.map((item) => (
          <a href={item.href} class="py-3 border-b border-ink/5 text-base" data-menu-link>
            {t(`nav.${item.key}`)}
          </a>
        ))
      }
      <div class="flex items-center justify-between pt-4">
        <LanguageSwitcher locale={locale} pagePath={pagePath} />
        <a href={localizePath(locale, "contact") + "#enquire"} class="btn btn-primary" data-menu-link>
          {t("nav.enquire")}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  const iconOpen = document.querySelector<SVGElement>("[data-icon-open]");
  const iconClose = document.querySelector<SVGElement>("[data-icon-close]");

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    panel.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  }

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    setOpen(!open);
  });

  // Close after tapping a link.
  document.querySelectorAll("[data-menu-link]").forEach((link) =>
    link.addEventListener("click", () => setOpen(false))
  );
</script>
