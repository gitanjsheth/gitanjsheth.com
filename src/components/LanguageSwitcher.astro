---
/**
 * Language switcher — a globe + the currently-selected language + a caret,
 * opening a dropdown list of languages. Scales to 4+ locales. Swaps to the
 * SAME page in the chosen locale and persists the choice (cookie + localStorage)
 * so the root gate is skipped next time.
 */
import { locales, localeLabels, localizePath, type Locale } from "../i18n/utils";
import { LOCALE_STORAGE_KEY } from "../config";

interface Props {
  locale: Locale;
  pagePath: string;
  class?: string;
}
const { locale, pagePath, class: className = "" } = Astro.props;
---

<div class={`lang-switch relative ${className}`} data-lang-switch data-storage-key={LOCALE_STORAGE_KEY}>
  <button
    type="button"
    class="lang-switch__trigger inline-flex items-center gap-1.5 text-sm"
    aria-haspopup="true"
    aria-expanded="false"
    data-lang-trigger
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.8 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.8-3.8-9S9.5 5.6 12 3z" />
    </svg>
    <span data-lang-current>{localeLabels[locale]}</span>
    <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" class="lang-switch__caret">
      <path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <div class="lang-switch__dropdown" role="menu" data-lang-dropdown>
    <div class="lang-switch__panel">
      {
        locales.map((loc) => (
          <a
            href={localizePath(loc, pagePath)}
            hreflang={loc}
            lang={loc}
            role="menuitem"
            data-locale={loc}
            aria-current={loc === locale ? "true" : undefined}
            class:list={["lang-switch__link", loc === locale ? "is-current" : ""]}
          >
            {localeLabels[loc]}
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .lang-switch__trigger {
    color: var(--ink);
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0.25rem 0;
  }
  .section-ink .lang-switch__trigger {
    color: var(--ivory);
  }
  .lang-switch__caret {
    transition: transform 250ms ease;
    color: var(--gold);
  }
  .lang-switch__dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    padding-top: 0.6rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity 200ms ease, transform 200ms ease;
    z-index: 50;
  }
  .lang-switch__panel {
    min-width: 9rem;
    background: var(--paper);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    border-radius: 4px;
    box-shadow: 0 12px 32px -12px color-mix(in srgb, var(--ink) 30%, transparent);
    padding: 0.4rem;
  }
  .lang-switch__link {
    display: block;
    padding: 0.5rem 0.8rem;
    border-radius: 3px;
    font-size: 0.9rem;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 200ms ease;
  }
  .lang-switch__link:hover,
  .lang-switch__link:focus-visible {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .lang-switch__link.is-current {
    color: var(--gold);
    font-weight: 600;
  }
  .lang-switch:hover .lang-switch__dropdown,
  .lang-switch:focus-within .lang-switch__dropdown,
  .lang-switch[data-open="true"] .lang-switch__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  .lang-switch:hover .lang-switch__caret,
  .lang-switch:focus-within .lang-switch__caret,
  .lang-switch[data-open="true"] .lang-switch__caret {
    transform: rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-lang-switch]").forEach((sw) => {
    const key = sw.dataset.storageKey || "gsco_locale";
    const trigger = sw.querySelector<HTMLButtonElement>("[data-lang-trigger]");

    trigger?.addEventListener("click", (e) => {
      e.preventDefault();
      const open = sw.getAttribute("data-open") === "true";
      sw.setAttribute("data-open", String(!open));
      trigger.setAttribute("aria-expanded", String(!open));
    });

    document.addEventListener("click", (e) => {
      if (!sw.contains(e.target as Node)) {
        sw.removeAttribute("data-open");
        trigger?.setAttribute("aria-expanded", "false");
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        sw.removeAttribute("data-open");
        trigger?.setAttribute("aria-expanded", "false");
      }
    });

    // Persist the chosen locale so the gate stays skipped.
    sw.querySelectorAll<HTMLAnchorElement>("a[data-locale]").forEach((a) => {
      a.addEventListener("click", () => {
        const loc = a.dataset.locale;
        if (!loc) return;
        try {
          localStorage.setItem(key, loc);
        } catch {}
        document.cookie = `${key}=${loc}; path=/; max-age=31536000; samesite=lax`;
      });
    });
  });
</script>
