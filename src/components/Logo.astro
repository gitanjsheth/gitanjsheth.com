---
/**
 * Wordmark lockup: the GS mark + firm name. Until a dedicated horizontal
 * wordmark asset is supplied, this composes one from the mark SVG and type.
 *   variant="ink"      -> ink mark, for LIGHT (ivory) backgrounds
 *   variant="reversed" -> ivory/white mark, for DARK (ink) sections
 */
interface Props {
  variant?: "ink" | "reversed";
  /** Show the "Gitanj Sheth & Co." wordmark text beside the mark. */
  showText?: boolean;
  class?: string;
}
const { variant = "ink", showText = true, class: className = "" } = Astro.props;

const src = variant === "reversed" ? "/logo/gs-nocorners-white.svg" : "/logo/gs-nocorners-ink.svg";
const textColor = variant === "reversed" ? "text-ivory" : "text-ink";
---

<span class={`inline-flex items-center gap-3 ${className}`}>
  <img src={src} alt="" aria-hidden="true" class="h-9 w-auto" width="36" height="36" />
  {
    showText && (
      <span
        class={`font-display leading-none ${textColor}`}
        style="font-size:1.15rem;letter-spacing:0.01em;"
      >
        Gitanj Sheth <span style="color:var(--gold)">&amp;</span> Co.
      </span>
    )
  }
</span>
