---
/**
 * Full testimonial card for the /testimonials page:
 *  - signatory photo in a SQUARE crop (max 4px radius; never circular)
 *  - name / company / field
 *  - the locale-appropriate pulled quote
 *  - a small letter-thumbnail cutout labelled "View testimonial letter"
 *  - clicking opens the full letter image (the untranslated English artefact)
 *    in a native <dialog> lightbox.
 * When no real letter exists yet, a clean labelled placeholder box is shown.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  id: string;
  name: string;
  company: string;
  field: string;
  quote: string;
  photo?: string;
  letterImage?: string;
  letterThumb?: string;
  placeholder?: boolean;
}
const { locale, id, name, company, field, quote, photo, letterImage, letterThumb, placeholder = false } =
  Astro.props;
const t = useTranslations(locale);

// Resolve signatory photos from src/assets/people (Astro-optimised).
const peopleImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/people/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);
const photoKey = photo ? `/src/assets/${photo}` : undefined;
const photoImg = photoKey && peopleImages[photoKey] ? peopleImages[photoKey].default : undefined;

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? "")
  .join("");

const dialogId = `letter-${id}`;
const hasLetter = Boolean(letterImage);
---

<article class="card flex h-full flex-col p-6" lang={locale}>
  <div class="flex items-start gap-4">
    <!-- Signatory photo: SQUARE, max 4px radius (never circular). -->
    {
      photoImg ? (
        <Image
          src={photoImg}
          alt={name}
          width={112}
          height={112}
          class="h-16 w-16 flex-shrink-0 rounded-card object-cover"
        />
      ) : (
        <span
          class="flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-card bg-ink/5 font-display text-xl text-ink/60"
          aria-hidden="true"
        >
          {initials}
        </span>
      )
    }
    <div class="min-w-0">
      <h3 class="text-lg leading-tight">{name}</h3>
      <p class="text-sm text-muted">{company}</p>
      <p class="mt-1 text-xs">
        <span class="eyebrow">{t("testimonials.fieldLabel")}</span>
        <span class="ml-2 text-muted">{field}</span>
      </p>
    </div>
  </div>

  <blockquote class="mt-5 flex-1 text-base leading-relaxed">
    <span class="text-gold font-display" aria-hidden="true">&ldquo;</span>{quote}<span
      class="text-gold font-display"
      aria-hidden="true">&rdquo;</span>
  </blockquote>

  <!-- Letter cutout + trigger, or a clean labelled placeholder. -->
  <div class="mt-6 border-t border-ink/10 pt-5">
    {
      hasLetter ? (
        <button type="button" class="group flex items-center gap-3 text-left" data-open-dialog={dialogId}>
          <span class="block h-16 w-12 flex-shrink-0 overflow-hidden rounded-card border border-ink/15 bg-paper">
            {letterThumb ? (
              <img src={letterThumb} alt="" aria-hidden="true" class="h-full w-full object-cover object-top" />
            ) : (
              <span class="flex h-full w-full items-center justify-center text-[0.55rem] text-muted">PDF</span>
            )}
          </span>
          <span class="link text-sm">{t("testimonials.viewLetter")}</span>
        </button>
      ) : (
        <div class="flex items-center gap-3" aria-label={`${t("testimonials.letterPlaceholder")} — ${company}`}>
          <span class="flex h-16 w-12 flex-shrink-0 items-center justify-center rounded-card border border-dashed border-ink/25 bg-ink/[0.02] text-[0.5rem] uppercase tracking-caps text-muted">
            letter
          </span>
          <span class="text-sm text-muted">
            {t("testimonials.letterPlaceholder")}
            <span class="block text-xs opacity-70">{company}</span>
          </span>
        </div>
      )
    }
  </div>

  <!-- Lightbox: the full, untranslated letter scan (identical in both locales). -->
  {
    hasLetter && (
      <dialog id={dialogId} class="letter-dialog" aria-label={`${t("testimonials.letterPlaceholder")} — ${name}`}>
        <div class="letter-dialog__inner">
          <button type="button" class="letter-dialog__close" data-close-dialog aria-label={t("testimonials.closeLetter")}>
            &times;
          </button>
          <img src={letterImage} alt={`Testimonial letter — ${name}, ${company}`} class="letter-dialog__img" />
        </div>
      </dialog>
    )
  }
</article>
