---
/**
 * Infinite, swipeable, peeking testimonials carousel.
 *
 * Approach (deliberately simple + robust):
 *  - Cards are absolutely positioned and placed around the centre using modulo
 *    maths, so there are NO clones and NO native scrolling to fight.
 *  - One continuous `pos` chases an unbounded integer `target`. Arrows just do
 *    `target += ±1`, so any click rate (10/s+) stays smooth and never gets
 *    stuck at an end. It centres instantly on load, so there's no flicker.
 *  - Touch/pointer drag is handled directly; the nearest card snaps on release.
 *
 * Each card, top → bottom: industry banner · pulled quote · square photo +
 * name / company, city / industry · faded letter-glimpse → lightbox.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  items: CollectionEntry<"testimonials">[];
}
const { locale, items } = Astro.props;
const t = useTranslations(locale);

const peopleImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/people/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);
const industryImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/industries/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);

/** Map testimonial industry labels → banner asset slug. */
const INDUSTRY_BANNER: Record<string, string> = {
  "Real Estate": "real-estate",
  Trading: "trading",
  "Fashion Export": "fashion-export",
  Education: "education",
  "Project Consultancy": "project-consultancy",
  Manufacturing: "manufacturing",
  Technology: "technology",
};

function resolvePhoto(photo?: string) {
  if (!photo) return undefined;
  const key = `/src/assets/${photo}`;
  return peopleImages[key]?.default;
}
function resolveIndustryBanner(industry?: string) {
  if (!industry) return undefined;
  const slug = INDUSTRY_BANNER[industry];
  if (!slug) return undefined;
  return industryImages[`/src/assets/industries/${slug}.jpg`]?.default;
}
function initialsOf(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? "")
    .join("");
}
---

<div class="tcar" data-carousel>
  <div class="tcar__stage" data-carousel-track role="group" aria-roledescription="carousel">
    {
      items.map((x, i) => {
        const d = x.data;
        const quote = locale === "hi" ? d.quote_hi : d.quote_en;
        const photoImg = resolvePhoto(d.photo);
        const bannerImg = resolveIndustryBanner(d.industry);
        const hasLetter = Boolean(d.letterImage);
        const dialogId = `tcar-letter-${x.id}`;
        return (
          <figure class="tcar__card" data-carousel-card aria-label={`${i + 1} / ${items.length}`} lang={locale}>
            {bannerImg && (
              <div class="tcar__banner">
                <Image src={bannerImg} alt="" width={640} height={64} class="tcar__banner-img" />
              </div>
            )}
            <blockquote class="tcar__quote">
              <span class="tcar__mark" aria-hidden="true">&ldquo;</span>
              {quote}
            </blockquote>

            <figcaption class="tcar__meta">
              {photoImg ? (
                <Image src={photoImg} alt={d.name} width={112} height={112} class="tcar__photo" />
              ) : (
                <span class="tcar__photo tcar__photo--ph" aria-hidden="true">{initialsOf(d.name)}</span>
              )}
              <span class="tcar__who" lang="en">
                <span class="tcar__name">{d.name}</span>
                <span class="tcar__company">{d.company}, {d.city}</span>
                <span class="tcar__industry">{d.industry}</span>
              </span>
            </figcaption>

            <div class="tcar__letter">
              {hasLetter ? (
                <button type="button" class="tcar__glimpse" data-open-dialog={dialogId} aria-label={t("testimonials.viewLetter")}>
                  <span class="tcar__glimpse-img" style={`background-image:url('${d.letterThumb ?? d.letterImage}')`}></span>
                  <span class="tcar__glimpse-label">{t("testimonials.viewLetter")}</span>
                </button>
              ) : (
                <div class="tcar__glimpse tcar__glimpse--ph" aria-hidden="true">
                  <span class="tcar__glimpse-img tcar__glimpse-img--ph"></span>
                  <span class="tcar__glimpse-label tcar__glimpse-label--muted">{t("testimonials.viewLetter")}</span>
                </div>
              )}
            </div>

            {hasLetter && (
              <dialog id={dialogId} class="letter-dialog" data-letter-dialog aria-label={`${t("testimonials.letterPlaceholder")} — ${d.name}`}>
                <button type="button" class="letter-dialog__close" data-close-dialog aria-label={t("testimonials.closeLetter")}>&times;</button>
                <div class="letter-dialog__inner">
                  <img src={d.letterImage} alt={`Testimonial letter — ${d.name}, ${d.company}`} class="letter-dialog__img" draggable="false" loading="lazy" decoding="async" />
                </div>
              </dialog>
            )}
          </figure>
        );
      })
    }
  </div>

  <!-- Controls (hover-revealed on desktop) -->
  <button type="button" class="tcar__arrow tcar__arrow--prev" data-carousel-prev aria-label={t("testimonials.prev")}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button type="button" class="tcar__arrow tcar__arrow--next" data-carousel-next aria-label={t("testimonials.next")}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<style>
  .tcar {
    position: relative;
  }

  /* Stage: a fixed-height clipping window; cards are absolutely placed inside. */
  .tcar__stage {
    position: relative;
    width: 100%;
    overflow: hidden;
    touch-action: pan-y; /* vertical page scroll passes through; we own horizontal */
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .tcar__stage.is-ready {
    opacity: 1;
  }
  .tcar__stage.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .tcar__card {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(34rem, 85%);
    /* transform is set per-frame by JS: translateX(calc(-50% + Npx)) */
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink); /* explicit, so card text never inherits a dark section's ivory */
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    border-radius: 4px;
    padding: 1.75rem;
    margin: 0;
    transition: border-color 300ms ease;
    will-change: transform;
  }
  /* Inactive cards fade toward LIGHT (an ivory veil), not toward transparent,
     so a peeking card reads as a clean faded card on ANY section colour —
     the same look the experts carousel gets for free on its light section —
     instead of letting a dark section bleed through and turn muddy. */
  .tcar__card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--ivory);
    opacity: 0.5;
    transition: opacity 300ms ease;
    pointer-events: none;
  }
  .tcar__card.is-active {
    border-color: color-mix(in srgb, var(--gold) 45%, transparent);
  }
  .tcar__card.is-active::after {
    opacity: 0;
  }

  /* Photo band above the quote: fixed 64px tall, exactly the quote's width,
     centre-cropped (object-position centre) so narrowing the card trims the
     sides while the centre stays put. */
  .tcar__banner {
    width: 100%;
    height: 64px;
    overflow: hidden;
    border-radius: 4px;
    margin-bottom: 1.25rem;
  }
  .tcar__banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .tcar__quote {
    font-size: 1.15rem;
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }
  .tcar__mark {
    color: var(--gold);
    font-family: theme("fontFamily.display");
    font-size: 1.4rem;
    margin-right: 0.15rem;
  }

  .tcar__meta {
    display: flex;
    align-items: center;
    /* / --hi-scale keeps meta geometry identical on /en/ and /hi/ */
    gap: calc(0.9rem / var(--hi-scale));
    padding-top: calc(1rem / var(--hi-scale));
    border-top: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .tcar__photo {
    width: calc(4.68rem / var(--hi-scale));
    height: calc(4.68rem / var(--hi-scale));
    flex: none;
    border-radius: 4px; /* SQUARE crop, never circular */
    object-fit: cover;
  }
  .tcar__photo--ph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    color: color-mix(in srgb, var(--ink) 55%, transparent);
    font-family: theme("fontFamily.display");
    font-size: calc(1.05rem / var(--hi-scale));
  }
  /* Match photo height when short → name top / industry bottom, equal gaps.
     When text exceeds photo, who grows and meta's align-items:center keeps it centred.
     All sizes ÷ --hi-scale so Latin meta matches /en/ on /hi/ pages. */
  .tcar__who {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(4.68rem / var(--hi-scale));
    font-size: calc(1em / var(--hi-scale));
    line-height: 1.3;
  }
  .tcar__name { font-weight: 600; }
  .tcar__company { font-size: calc(0.9rem / var(--hi-scale)); color: var(--muted); }
  .tcar__industry {
    font-family: theme("fontFamily.mono");
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: clamp(
      calc(0.875rem / var(--hi-scale)),
      calc(0.823rem / var(--hi-scale) + 0.22vw),
      calc(1rem / var(--hi-scale))
    );
    color: var(--muted);
  }

  /* Letter-glimpse: the letter fades out toward the bottom. */
  .tcar__letter { margin-top: 1.25rem; }
  .tcar__glimpse {
    position: relative;
    display: block;
    width: 100%;
    text-align: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .tcar__glimpse--ph { cursor: default; }
  .tcar__glimpse-img {
    display: block;
    height: 6.5rem;
    background-size: cover;
    background-position: top center;
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
  }
  .tcar__glimpse-img--ph {
    background: repeating-linear-gradient(
      color-mix(in srgb, var(--ink) 4%, transparent) 0 0.55rem,
      transparent 0.55rem 1.1rem
    );
  }
  .tcar__glimpse-label {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--ink);
  }
  .tcar__glimpse-label--muted { color: var(--muted); }
  .tcar__glimpse:hover .tcar__glimpse-label { color: var(--gold); }

  /* Arrows */
  .tcar__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.6rem;
    height: 2.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: 999px;
    box-shadow: 0 8px 24px -12px color-mix(in srgb, var(--ink) 40%, transparent);
    cursor: pointer;
    opacity: 0;
    transition: opacity 200ms ease, background-color 200ms ease;
    z-index: 20;
  }
  .tcar:hover .tcar__arrow { opacity: 1; }
  .tcar__arrow:focus-visible { opacity: 1; }
  .tcar__arrow:hover { background: var(--ivory); }
  .tcar__arrow--prev { left: 0.5rem; }
  .tcar__arrow--next { right: 0.5rem; }
  @media (hover: none) {
    .tcar__arrow { display: none; } /* touch devices swipe instead */
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const stage = root.querySelector<HTMLElement>("[data-carousel-track]");
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-carousel-card]"));
    const N = cards.length;
    if (!stage || N === 0) return;

    const GAP = 20; // px, visual gap between cards
    let step = 0; // card width + gap
    let pos = 0; // continuous position; the card equal to `pos` is centred
    let target = 0; // desired integer position (unbounded — rapid clicks are fine)
    let raf = 0;

    const mod = (a: number, m: number) => ((a % m) + m) % m;

    function measure() {
      step = cards[0].getBoundingClientRect().width + GAP;
      // Equalise heights so the stage never jumps between cards.
      let maxH = 0;
      cards.forEach((c) => (c.style.height = "auto"));
      cards.forEach((c) => (maxH = Math.max(maxH, c.getBoundingClientRect().height)));
      cards.forEach((c) => (c.style.height = `${maxH}px`));
      stage.style.height = `${maxH}px`;
    }

    function render() {
      for (let i = 0; i < N; i++) {
        // Nearest signed distance from centre, wrapped into (-N/2, N/2].
        let d = mod(i - pos, N);
        if (d > N / 2) d -= N;
        const card = cards[i];
        card.style.transform = `translateX(calc(-50% + ${d * step}px))`;
        const ad = Math.abs(d);
        card.classList.toggle("is-active", ad < 0.5);
        card.style.zIndex = String(N - Math.round(ad));
        // The single opposite-most card is off-stage; hide it from paint + tab order.
        card.style.visibility = ad > N / 2 - 0.001 ? "hidden" : "visible";
      }
    }

    function tick() {
      const diff = target - pos;
      if (Math.abs(diff) < 0.001) {
        // Settled — fold the counters back into [0, N) so numbers stay small.
        pos = target = mod(target, N);
        render();
        raf = 0;
        return;
      }
      pos += diff * 0.2; // smooth exponential approach; robust at any click rate
      render();
      raf = requestAnimationFrame(tick);
    }
    const animate = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    const go = (dir: number) => {
      target += dir;
      animate();
    };
    root.querySelector("[data-carousel-prev]")?.addEventListener("click", () => go(-1));
    root.querySelector("[data-carousel-next]")?.addEventListener("click", () => go(1));

    // --- Pointer / touch drag ------------------------------------------------
    let dragging = false;
    let moved = false;
    let startX = 0;
    let startPos = 0;
    let pid = -1;
    stage.addEventListener("pointerdown", (e) => {
      dragging = true;
      moved = false;
      startX = e.clientX;
      startPos = pos;
      pid = e.pointerId;
      if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    });
    stage.addEventListener("pointermove", (e) => {
      if (!dragging || !step) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 6) {
        moved = true;
        stage.setPointerCapture(pid);
        stage.classList.add("is-dragging");
      }
      if (moved) {
        pos = startPos - dx / step;
        render();
      }
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      stage.classList.remove("is-dragging");
      if (moved) {
        target = Math.round(pos);
        animate();
      }
    };
    stage.addEventListener("pointerup", endDrag);
    stage.addEventListener("pointercancel", endDrag);

    // --- Letter lightboxes (suppressed if the press was a drag) --------------
    root.querySelectorAll<HTMLButtonElement>("[data-open-dialog]").forEach((btn) => {
      const id = btn.getAttribute("data-open-dialog");
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) {
        btn.addEventListener("click", () => {
          if (!moved) dialog.showModal();
        });
      }
    });
    root.querySelectorAll<HTMLDialogElement>("dialog.letter-dialog").forEach((dialog) => {
      dialog.querySelector("[data-close-dialog]")?.addEventListener("click", () => dialog.close());
      // Click on the empty space above/below the letter (the dialog/backdrop) closes.
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
      // View-only: block the right-click / long-press context menu so the letter
      // can't be saved, and swallow drag attempts. (Zoom/print are further
      // discouraged via CSS; nothing can be fully prevented in a browser.)
      dialog.addEventListener("contextmenu", (e) => e.preventDefault());
      dialog.addEventListener("dragstart", (e) => e.preventDefault());
    });

    // --- Init synchronously so the first paint is already centred (no flicker).
    measure();
    render();
    stage.classList.add("is-ready");
    // Fonts/images can change heights after load; re-measure then.
    window.addEventListener("load", () => {
      measure();
      render();
    });
    let rt: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(rt);
      rt = setTimeout(() => {
        measure();
        render();
      }, 100);
    });
  });
</script>
