---
/**
 * Full testimonials grid for /testimonials — shows the full set as a wall of
 * trust (not a carousel). Two equal columns above 768px; one column below.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  items: CollectionEntry<"testimonials">[];
}
const { locale, items } = Astro.props;
const t = useTranslations(locale);

const peopleImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/people/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);
function resolvePhoto(photo?: string) {
  if (!photo) return undefined;
  return peopleImages[`/src/assets/${photo}`]?.default;
}
function initialsOf(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? "")
    .join("");
}
---

<div class="tgrid" data-tgrid>
  <ul class="tgrid__list">
    {
      items.map((x) => {
        const d = x.data;
        const quote = locale === "hi" ? d.quote_hi : d.quote_en;
        const photoImg = resolvePhoto(d.photo);
        const hasLetter = Boolean(d.letterImage);
        const dialogId = `tgrid-letter-${x.id}`;
        return (
          <li>
            <figure class="tgrid__card" lang={locale}>
              <blockquote class="tgrid__quote">
                <span class="tgrid__mark" aria-hidden="true">&ldquo;</span>
                {quote}
              </blockquote>

              <figcaption class="tgrid__meta">
                {photoImg ? (
                  <Image src={photoImg} alt={d.name} width={112} height={112} class="tgrid__photo" />
                ) : (
                  <span class="tgrid__photo tgrid__photo--ph" aria-hidden="true">{initialsOf(d.name)}</span>
                )}
                <span class="tgrid__who">
                  <span class="tgrid__name">{d.name}</span>
                  <span class="tgrid__company">{d.company}, {d.city}</span>
                  <span class="tgrid__industry">{d.industry}</span>
                </span>
              </figcaption>

              <div class="tgrid__letter">
                {hasLetter ? (
                  <button type="button" class="tgrid__glimpse" data-open-dialog={dialogId} aria-label={t("testimonials.viewLetter")}>
                    <span class="tgrid__glimpse-img" style={`background-image:url('${d.letterThumb ?? d.letterImage}')`}></span>
                    <span class="tgrid__glimpse-label">{t("testimonials.viewLetter")}</span>
                  </button>
                ) : (
                  <div class="tgrid__glimpse tgrid__glimpse--ph" aria-hidden="true">
                    <span class="tgrid__glimpse-img tgrid__glimpse-img--ph"></span>
                    <span class="tgrid__glimpse-label tgrid__glimpse-label--muted">{t("testimonials.viewLetter")}</span>
                  </div>
                )}
              </div>
            </figure>
          </li>
        );
      })
    }
  </ul>

  {
    items.map((x) => {
      const d = x.data;
      if (!d.letterImage) return null;
      const dialogId = `tgrid-letter-${x.id}`;
      return (
        <dialog id={dialogId} class="letter-dialog" data-letter-dialog aria-label={`${t("testimonials.letterPlaceholder")} — ${d.name}`}>
          <button type="button" class="letter-dialog__close" data-close-dialog aria-label={t("testimonials.closeLetter")}>&times;</button>
          <div class="letter-dialog__inner">
            <img src={d.letterImage} alt={`Testimonial letter — ${d.name}, ${d.company}`} class="letter-dialog__img" draggable="false" />
          </div>
        </dialog>
      );
    })
  }
</div>

<style>
  .tgrid__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .tgrid__list {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .tgrid__card {
    height: 100%;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 1.5rem;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    border-radius: 4px;
  }

  .tgrid__quote {
    margin: 0;
    flex: 1;
    font-size: 1.05rem;
    line-height: 1.55;
  }
  .tgrid__mark {
    font-family: theme("fontFamily.display");
    font-size: 1.6rem;
    line-height: 0;
    color: var(--gold);
    margin-right: 0.15rem;
  }

  .tgrid__meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.25rem;
  }
  .tgrid__photo {
    width: 3.25rem;
    height: 3.25rem;
    flex: none;
    border-radius: 4px;
    object-fit: cover;
  }
  .tgrid__photo--ph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    color: color-mix(in srgb, var(--ink) 55%, transparent);
    font-family: theme("fontFamily.display");
    font-size: 1.05rem;
  }
  .tgrid__who { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .tgrid__name { font-weight: 600; }
  .tgrid__company { font-size: 0.9rem; color: var(--muted); }
  .tgrid__industry {
    font-family: theme("fontFamily.mono");
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  .tgrid__letter { margin-top: 1.25rem; }
  .tgrid__glimpse {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: center;
  }
  .tgrid__glimpse--ph { cursor: default; }
  .tgrid__glimpse-img {
    display: block;
    height: 4.5rem;
    border-radius: 3px;
    background-size: cover;
    background-position: top center;
    mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
  }
  .tgrid__glimpse-img--ph {
    background: color-mix(in srgb, var(--ink) 6%, var(--paper));
  }
  .tgrid__glimpse-label {
    display: inline-block;
    margin-top: 0.55rem;
    font-size: 0.85rem;
    color: var(--ink);
    transition: color 200ms ease;
  }
  .tgrid__glimpse-label--muted { color: var(--muted); }
  .tgrid__glimpse:hover .tgrid__glimpse-label { color: var(--gold); }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-tgrid]").forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>("[data-open-dialog]").forEach((btn) => {
      const id = btn.getAttribute("data-open-dialog");
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) {
        btn.addEventListener("click", () => dialog.showModal());
      }
    });
    root.querySelectorAll<HTMLDialogElement>("dialog.letter-dialog").forEach((dialog) => {
      dialog.querySelector("[data-close-dialog]")?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
      dialog.addEventListener("contextmenu", (e) => e.preventDefault());
      dialog.addEventListener("dragstart", (e) => e.preventDefault());
    });
  });
</script>
