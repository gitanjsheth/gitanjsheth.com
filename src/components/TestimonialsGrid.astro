---
/**
 * Full testimonials grid for /testimonials — shows the full set as a wall of
 * trust (not a carousel). Two equal columns above 768px; one column below.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  items: CollectionEntry<"testimonials">[];
}
const { locale, items } = Astro.props;
const t = useTranslations(locale);

const peopleImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/people/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);
const industryImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/industries/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);

/** Map testimonial industry labels → banner asset slug. */
const INDUSTRY_BANNER: Record<string, string> = {
  "Real Estate": "real-estate",
  Trading: "trading",
  "Fashion Export": "fashion-export",
  Education: "education",
  "Project Consultancy": "project-consultancy",
  Manufacturing: "manufacturing",
  Technology: "technology",
};

function resolvePhoto(photo?: string) {
  if (!photo) return undefined;
  return peopleImages[`/src/assets/${photo}`]?.default;
}
function resolveIndustryBanner(industry?: string) {
  if (!industry) return undefined;
  const slug = INDUSTRY_BANNER[industry];
  if (!slug) return undefined;
  return industryImages[`/src/assets/industries/${slug}.jpg`]?.default;
}
function initialsOf(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? "")
    .join("");
}
---

<div class="tgrid" data-tgrid>
  <ul class="tgrid__list">
    {
      items.map((x) => {
        const d = x.data;
        const quote = locale === "hi" ? d.quote_hi : d.quote_en;
        const photoImg = resolvePhoto(d.photo);
        const bannerImg = resolveIndustryBanner(d.industry);
        const hasLetter = Boolean(d.letterImage);
        const dialogId = `tgrid-letter-${x.id}`;
        return (
          <li>
            <figure class="tgrid__card" lang={locale}>
              {bannerImg && (
                <div class="tgrid__banner">
                  <Image src={bannerImg} alt="" width={640} height={64} class="tgrid__banner-img" />
                </div>
              )}
              <blockquote class="tgrid__quote">
                <span class="tgrid__mark" aria-hidden="true">&ldquo;</span>
                {quote}
              </blockquote>

              <figcaption class="tgrid__meta">
                {photoImg ? (
                  <Image src={photoImg} alt={d.name} width={112} height={112} class="tgrid__photo" />
                ) : (
                  <span class="tgrid__photo tgrid__photo--ph" aria-hidden="true">{initialsOf(d.name)}</span>
                )}
                <span class="tgrid__who" lang="en">
                  <span class="tgrid__name">{d.name}</span>
                  <span class="tgrid__company">{d.company}, {d.city}</span>
                  <span class="tgrid__industry">{d.industry}</span>
                </span>
              </figcaption>

              <div class="tgrid__letter">
                {hasLetter ? (
                  <button type="button" class="tgrid__glimpse" data-open-dialog={dialogId} aria-label={t("testimonials.viewLetter")}>
                    <span class="tgrid__glimpse-img" style={`background-image:url('${d.letterThumb ?? d.letterImage}')`}></span>
                    <span class="tgrid__glimpse-label">{t("testimonials.viewLetter")}</span>
                  </button>
                ) : (
                  <div class="tgrid__glimpse tgrid__glimpse--ph" aria-hidden="true">
                    <span class="tgrid__glimpse-img tgrid__glimpse-img--ph"></span>
                    <span class="tgrid__glimpse-label tgrid__glimpse-label--muted">{t("testimonials.viewLetter")}</span>
                  </div>
                )}
              </div>
            </figure>
          </li>
        );
      })
    }
  </ul>

  {
    items.map((x) => {
      const d = x.data;
      if (!d.letterImage) return null;
      const dialogId = `tgrid-letter-${x.id}`;
      return (
        <dialog id={dialogId} class="letter-dialog" data-letter-dialog aria-label={`${t("testimonials.letterPlaceholder")} — ${d.name}`}>
          <button type="button" class="letter-dialog__close" data-close-dialog aria-label={t("testimonials.closeLetter")}>&times;</button>
          <div class="letter-dialog__inner">
            <img src={d.letterImage} alt={`Testimonial letter — ${d.name}, ${d.company}`} class="letter-dialog__img" draggable="false" loading="lazy" decoding="async" />
          </div>
        </dialog>
      );
    })
  }
</div>

<style>
  .tgrid__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .tgrid__list {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .tgrid__card {
    height: 100%;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 1.5rem;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    border-radius: 4px;
  }

  /* Industry band above the quote — same 64px strip as the home carousel. */
  .tgrid__banner {
    width: 100%;
    height: 64px;
    overflow: hidden;
    border-radius: 4px;
    margin-bottom: 1.25rem;
    flex: none;
  }
  .tgrid__banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .tgrid__quote {
    margin: 0;
    flex: 1;
    font-size: 1.05rem;
    line-height: 1.55;
  }
  .tgrid__mark {
    font-family: theme("fontFamily.display");
    font-size: 1.6rem;
    line-height: 0;
    color: var(--gold);
    margin-right: 0.15rem;
  }

  .tgrid__meta {
    display: flex;
    align-items: center;
    /* / --hi-scale keeps meta geometry identical on /en/ and /hi/ */
    gap: calc(0.85rem / var(--hi-scale));
    margin-top: calc(1.25rem / var(--hi-scale));
  }
  .tgrid__photo {
    width: calc(4.68rem / var(--hi-scale));
    height: calc(4.68rem / var(--hi-scale));
    flex: none;
    border-radius: 4px;
    object-fit: cover;
  }
  .tgrid__photo--ph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    color: color-mix(in srgb, var(--ink) 55%, transparent);
    font-family: theme("fontFamily.display");
    font-size: calc(1.05rem / var(--hi-scale));
  }
  /* Match photo height when short → name top / industry bottom, equal gaps.
     When text exceeds photo, who grows and meta's align-items:center keeps it centred.
     All sizes ÷ --hi-scale so Latin meta matches /en/ on /hi/ pages. */
  .tgrid__who {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(4.68rem / var(--hi-scale));
    font-size: calc(1em / var(--hi-scale));
    line-height: 1.3;
    min-width: 0;
  }
  .tgrid__name { font-weight: 600; }
  .tgrid__company { font-size: calc(0.9rem / var(--hi-scale)); color: var(--muted); }
  .tgrid__industry {
    font-family: theme("fontFamily.mono");
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: clamp(
      calc(0.875rem / var(--hi-scale)),
      calc(0.823rem / var(--hi-scale) + 0.22vw),
      calc(1rem / var(--hi-scale))
    );
    color: var(--muted);
  }

  .tgrid__letter { margin-top: 1.25rem; }
  .tgrid__glimpse {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: center;
  }
  .tgrid__glimpse--ph { cursor: default; }
  .tgrid__glimpse-img {
    display: block;
    height: 4.5rem;
    border-radius: 3px;
    background-size: cover;
    background-position: top center;
    mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
  }
  .tgrid__glimpse-img--ph {
    background: color-mix(in srgb, var(--ink) 6%, var(--paper));
  }
  .tgrid__glimpse-label {
    display: inline-block;
    margin-top: 0.55rem;
    font-size: 0.85rem;
    color: var(--ink);
    transition: color 200ms ease;
  }
  .tgrid__glimpse-label--muted { color: var(--muted); }
  .tgrid__glimpse:hover .tgrid__glimpse-label { color: var(--gold); }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-tgrid]").forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>("[data-open-dialog]").forEach((btn) => {
      const id = btn.getAttribute("data-open-dialog");
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) {
        btn.addEventListener("click", () => dialog.showModal());
      }
    });
    root.querySelectorAll<HTMLDialogElement>("dialog.letter-dialog").forEach((dialog) => {
      dialog.querySelector("[data-close-dialog]")?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
      dialog.addEventListener("contextmenu", (e) => e.preventDefault());
      dialog.addEventListener("dragstart", (e) => e.preventDefault());
    });
  });
</script>


<script>
  /* Background-warm the full letters AFTER the rest of the page has loaded, so
     a viewer who opens one sees it instantly — without the heavy letters
     competing with the initial render. The dialog <img> stays loading="lazy"
     (never fetched during first paint); once the page's other graphics are
     done we prefetch each letter on idle, one at a time, at low priority. */
  (() => {
    const warm = () => {
      const urls = Array.from(
        new Set(
          Array.from(
            document.querySelectorAll<HTMLImageElement>("img.letter-dialog__img")
          )
            .map((i) => i.getAttribute("src"))
            .filter((u): u is string => !!u)
        )
      );
      const ric: (cb: () => void) => void = (window as any).requestIdleCallback
        ? (cb) => (window as any).requestIdleCallback(cb)
        : (cb) => window.setTimeout(cb, 300);
      let i = 0;
      const step = () => {
        if (i >= urls.length) return;
        const link = document.createElement("link");
        link.rel = "prefetch";
        link.as = "image";
        link.href = urls[i++];
        document.head.appendChild(link);
        ric(step);
      };
      ric(step);
    };
    if (document.readyState === "complete") warm();
    else window.addEventListener("load", warm, { once: true });
  })();
</script>
