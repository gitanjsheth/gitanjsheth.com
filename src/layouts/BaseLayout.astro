---
/**
 * BaseLayout — the single HTML shell every localized page renders through.
 * Sets <html lang>, per-page localized <title>/description, hreflang
 * alternates (+ x-default), Open Graph, favicon and self-hosted fonts.
 */
import "../styles/global.css";

// Self-hosted fonts (no external CDN). Grotesque display + mono eyebrows + body...
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
// ...and a clean modern Devanagari so /hi/ renders in the same family names.
import "@fontsource-variable/noto-sans-devanagari/wght.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  locales,
  localeHreflang,
  localizePath,
  useTranslations,
  type Locale,
} from "../i18n/utils";

export interface Props {
  locale: Locale;
  /** Locale-less page path, e.g. "home", "services", "case-studies/foo". */
  pagePath: string;
  title: string;
  description?: string;
  /** Set true on the language-gate root so the chrome (header/footer) is hidden. */
  bare?: boolean;
}

const { locale, pagePath, title, description, bare = false } = Astro.props;
const t = useTranslations(locale);

const siteName = t("site.name");
const firmName = t("site.firm");
const metaDescription = description ?? t("site.description");
const fullTitle = title && title !== siteName ? `${title} — ${siteName}` : siteName;

// Absolute URLs for canonical, hreflang and OG (Astro.site = https://gitanjsheth.com).
const site = Astro.site ?? new URL("https://gitanjsheth.com");
const canonical = new URL(localizePath(locale, pagePath), site).href;
const ogImage = new URL("/og-image.png", site).href;
---

<!doctype html>
<html lang={localeHreflang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={firmName} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon (SVG mark + PNG fallback) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <meta name="theme-color" content="#16233B" />

    <!-- hreflang alternates for every locale, plus x-default -->
    {
      locales.map((loc) => (
        <link
          rel="alternate"
          hreflang={localeHreflang[loc]}
          href={new URL(localizePath(loc, pagePath), site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizePath("en", pagePath), site).href}
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === "hi" ? "hi_IN" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="sr-only-focusable" href="#main">{t("common.skipToContent")}</a>
    {!bare && <Header locale={locale} pagePath={pagePath} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer locale={locale} />}
  </body>
</html>
