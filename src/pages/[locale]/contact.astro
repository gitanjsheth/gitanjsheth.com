---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EnquiryForm from "../../components/EnquiryForm.astro";
import { localeStaticPaths, useTranslations, type Locale } from "../../i18n/utils";
import { CONTACT_EMAIL } from "../../config";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const address = t("contact.address");
---

<BaseLayout locale={locale} pagePath="contact" title={t("contact.title")} description={t("contact.intro")}>
  <section>
    <div class="container-x py-12 md:py-20">
      <h1 class="h1">{t("contact.title")}</h1>
      <p class="mt-5 max-w-2xl whitespace-pre-line text-lg text-muted measure">{t("contact.intro")}</p>

      <div class="mt-10 grid gap-12 md:mt-12 md:grid-cols-[2fr_1fr]">
        <!-- Enquiry form (first on mobile) -->
        <div id="enquire" class="scroll-mt-24">
          <EnquiryForm locale={locale} />
        </div>

        <!-- Direct details (after the form on mobile) -->
        <aside>
          <div class="space-y-3 text-sm">
            <p>
              <a href={`mailto:${CONTACT_EMAIL}`} class="link">{CONTACT_EMAIL}</a>
            </p>
            <p class="text-muted measure">{address}</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
