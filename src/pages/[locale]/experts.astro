---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { localeStaticPaths, useTranslations, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

const experts = (await getCollection("experts")).sort(
  (a, b) => a.data.order - b.data.order
);

const peopleImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/people/*.{jpg,jpeg,png,JPG,JPEG,PNG}",
  { eager: true }
);
function resolvePhoto(photo?: string) {
  if (!photo) return undefined;
  return peopleImages[`/src/assets/${photo}`]?.default;
}
function initialsOf(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? "")
    .join("");
}
---

<BaseLayout locale={locale} pagePath="experts" title={t("experts.title")} description={t("experts.intro")}>
  <section>
    <div class="container-x pt-10 md:pt-16 pb-8 md:pb-10">
      <h1 class="h1">{t("experts.title")}</h1>
      <p class="mt-5 max-w-3xl text-lg text-muted">{t("experts.intro")}</p>
    </div>
  </section>

  {
    experts.map((e) => {
      const d = e.data;
      const photoImg = resolvePhoto(d.photo);
      const detail = (d.description ?? d.blurb)[locale];
      return (
        <section id={e.id} class="scroll-mt-24 border-t border-ink/10" lang={locale}>
          <div class="container-x grid gap-8 py-8 md:grid-cols-[20rem_1fr] md:gap-14 md:py-10">
            <div class="w-full max-w-xs md:max-w-none">
              {photoImg ? (
                <Image
                  src={photoImg}
                  alt={d.name}
                  width={600}
                  height={600}
                  class="w-full rounded-[4px] object-cover"
                  style="aspect-ratio:1/1;"
                />
              ) : (
                <div
                  class="flex items-center justify-center rounded-[4px] font-display text-4xl text-ink/40"
                  style="aspect-ratio:1/1;background:color-mix(in srgb, var(--ink) 6%, var(--paper));"
                  aria-hidden="true"
                >
                  {initialsOf(d.name)}
                </div>
              )}
            </div>
            <div>
              <h2 class="h3">{d.name}</h2>
              <p class="mt-3 font-mono text-xs uppercase tracking-caps text-muted">{d.domain[locale]}</p>
              <p class="mt-5 text-lg leading-relaxed">{detail}</p>
              {d.placeholder && (
                <span class="mt-5 inline-block font-mono text-xs uppercase tracking-caps text-muted opacity-60">placeholder</span>
              )}
            </div>
          </div>
        </section>
      );
    })
  }

  <CtaBand locale={locale} />
</BaseLayout>
