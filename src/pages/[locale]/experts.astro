---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeStaticPaths, useTranslations, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

const experts = (await getCollection("experts")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout locale={locale} pagePath="experts" title={t("experts.title")} description={t("experts.intro")}>
  <section>
    <div class="container-x py-16 md:py-24">
      <p class="eyebrow">{t("nav.experts")}</p>
      <h1 class="mt-4 text-4xl md:text-5xl">{t("experts.title")}</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted measure">{t("experts.intro")}</p>
    </div>
  </section>

  <section class="border-t border-ink/10">
    <div class="container-x py-14 md:py-20">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          experts.map((e) => (
            <article class="card flex h-full flex-col p-6" lang={locale}>
              <h2 class="text-xl">{e.data.name}</h2>
              <p class="mt-1">
                <span class="eyebrow">{t("experts.domainLabel")}</span>
                <span class="ml-2 text-sm text-muted">{e.data.domain[locale]}</span>
              </p>
              <p class="mt-4 text-sm text-muted measure">{e.data.blurb[locale]}</p>
              {e.data.placeholder && (
                <span class="eyebrow mt-4 inline-block opacity-60">placeholder</span>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
