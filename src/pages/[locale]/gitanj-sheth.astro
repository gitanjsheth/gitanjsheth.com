---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FounderPortrait from "../../components/FounderPortrait.astro";
import CtaBand from "../../components/CtaBand.astro";
import {
  localeStaticPaths,
  localizePath,
  useTranslations,
  type Locale,
} from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const trackRecord: { value: string; label: string }[] = t("person.trackRecord");
---

<BaseLayout
  locale={locale}
  pagePath="gitanj-sheth"
  title={t("person.eyebrow")}
  description={t("person.lead")}
>
  <!-- Header: portrait + lead -->
  <section class="section-ink">
    <div class="container-x flex flex-col items-center gap-8 py-12 sm:flex-row sm:items-end sm:justify-center sm:gap-12 sm:pb-0 sm:pt-12 md:gap-16">
      <div class="person-copy order-2 w-full max-w-[34rem] sm:order-1 sm:w-auto sm:flex-1">
        <h1 class="person-name">{t("person.name")}</h1>
        <p class="person-lead mt-5">{t("person.lead")}</p>
        <p class="person-combo mt-4 text-ivory/80">{t("person.combination")}</p>
      </div>
      <div class="person-media order-1 shrink-0 self-end sm:order-2">
        <FounderPortrait alt={t("home.hero.portraitAlt")} />
      </div>
    </div>
  </section>

  <!-- Track record -->
  <section>
    <div class="container-x py-12 md:py-20">
      <dl class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          trackRecord.map((tr) => (
            <div class="border-t border-ink/12 pt-4">
              <dt class="font-display text-3xl leading-none">{tr.value}</dt>
              <dd class="mt-2 text-sm text-muted">{tr.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Why + selectivity + background -->
  <section class="border-t border-ink/10">
    <div class="container-x grid gap-12 py-16 md:grid-cols-2 md:py-24">
      <div class="space-y-6">
        <p class="text-xl leading-relaxed measure">{t("person.why")}</p>
        <p class="text-lg text-muted measure">{t("person.selectivity")}</p>
      </div>
      <div class="space-y-5">
        <p>{t("person.education")}</p>
        <p>{t("person.roles")}</p>
        <p class="text-muted">{t("person.pedigree")}</p>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>
