---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FounderPortrait from "../../components/FounderPortrait.astro";
import CtaBand from "../../components/CtaBand.astro";
import { localeStaticPaths, useTranslations, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

// English-only for now (hardcoded); moves to i18n once locked.
const work = [
  { label: "Strategy & Growth", line: "When the next move isn't obvious." },
  { label: "Transformation", line: "When the way the business works has to change." },
  { label: "Technology", line: "When a technology decision is really a business decision." },
  { label: "Complex Problems", line: "When no single specialist has the whole answer." },
];
---

<BaseLayout
  locale={locale}
  pagePath="gitanj-sheth"
  title={t("person.eyebrow")}
  description="Gitanj Sheth has been the engineer, the founder, the operator and the client. He works on the problems that cross lines, where no single specialist has the whole answer."
>
  <!-- Header: name + qualifications + role line + portrait (blue) -->
  <section class="section-ink">
    <div class="container-x flex flex-col items-center gap-8 py-12 sm:flex-row sm:items-end sm:justify-center sm:gap-12 sm:pb-0 sm:pt-12 md:gap-16">
      <div class="person-copy order-2 w-full max-w-[34rem] sm:order-1 sm:w-auto sm:flex-1">
        <h1 class="person-name">{t("person.name")}</h1>
        <p class="mt-4 font-mono text-ivory/90" style="font-size: clamp(0.9375rem, 0.885rem + 0.22vw, 1.0625rem)">
          {t("person.qualifications")}
        </p>
        <p class="mt-6 text-lg text-ivory/85">
          He has been the engineer, the founder, the operator, and the client.
        </p>
      </div>
      <div class="person-media order-1 shrink-0 self-end sm:order-2">
        <FounderPortrait alt={t("home.hero.portraitAlt")} />
      </div>
    </div>
  </section>

  <!-- 1. The range (ivory) -->
  <section>
    <div class="container-x grid gap-x-12 gap-y-6 py-14 md:grid-cols-[1fr_1.7fr] md:py-24">
      <h2 class="h2">Not a career consultant.</h2>
      <div class="space-y-6 text-lg leading-relaxed">
        <p>
          Gitanj trained as an engineer and taught himself to program before an MBA at XLRI. Since
          then he has founded and run businesses, been both the employee and the employer, advised
          other founders, and sat on the client side of consulting himself.
        </p>
        <p>Most advisors have lived <em>one</em> of those roles. He has lived <em>most</em> of them.</p>
      </div>
    </div>
  </section>

  <!-- 2. The angle (blue) -->
  <section class="section-ink">
    <div class="container-x grid gap-x-12 gap-y-6 py-14 md:grid-cols-[1fr_1.7fr] md:py-24">
      <h2 class="h2">Most experts see one slice.</h2>
      <div class="space-y-6 text-lg leading-relaxed">
        <p class="text-ivory/85">
          An IT consultant sees technology. An engineer sees systems. An MBA sees the spreadsheet.
          Each of them is right, and each of them is partial.
        </p>
        <p>
          Having worked in each of those seats, Gitanj reads a problem through all of them at once.
          Not to be the best engineer or the sharpest MBA in the room, but to see how the pieces fit
          together, and where they don't.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. The problems that cross lines (ivory) -->
  <section>
    <div class="container-x grid gap-x-12 gap-y-6 py-14 md:grid-cols-[1fr_1.7fr] md:py-24">
      <h2 class="h2">The problems that cross lines.</h2>
      <div class="space-y-8 text-lg leading-relaxed">
        <p>
          The ones worth bringing him are hard not because they are complicated, but because
          <em>each part of the business is telling a different version of the truth.</em> Technology
          says one thing, operations another, finance a third, leadership a fourth.
        </p>
        <p class="vignette">
          The software works. Operations won't use it. Finance can't see the return. Leadership wants
          it scrapped. Everyone is partly right, and nothing moves.
        </p>
        <p>
          His work is to step into that gap, find out what is actually going on, and then face the
          harder question: what to do about it.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. Where he's brought in (blue) -->
  <section class="section-ink">
    <div class="container-x py-14 md:py-24">
      <h2 class="h2 max-w-2xl">Where he's brought in.</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {work.map(({ label, line }) => (
          <div class="card flex flex-col p-7">
            <h3 class="text-xl font-semibold">{label}</h3>
            <p class="mt-3 text-muted">{line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Close: open question (ivory), then the shared band -->
  <section>
    <div class="container-x py-16 md:py-28">
      <p class="close-q">Can you think of a problem Gitanj should look at?</p>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  /* Set-off scenario, quiet not shouty. */
  .vignette {
    padding-left: 1.25rem;
    border-left: 2px solid var(--gold);
    font-style: italic;
    color: var(--ink);
  }
  .section-ink .vignette {
    color: color-mix(in srgb, var(--ivory) 92%, transparent);
  }

  /* The open closing question, given room to breathe. */
  .close-q {
    font-family: theme("fontFamily.display");
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-size: clamp(1.75rem, 1.25rem + 2.1vw, 3.25rem); /* 28 -> 52 */
    max-width: 20ch;
  }
</style>
