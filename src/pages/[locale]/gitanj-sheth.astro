---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FounderPortrait from "../../components/FounderPortrait.astro";
import CtaBand from "../../components/CtaBand.astro";
import { localeStaticPaths, useTranslations, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

const content = {
  en: {
    s1h: "Specialists each see one slice.",
    s1p1: "The technologist sees the technology. The engineer sees the systems. The MBA sees the spreadsheet. Each of them is right, and each of them is partial.",
    s1p2: "The hardest problems aren't hard because they're complicated. They're hard because each part of the business is telling a different version of the truth.",
    vignette: "The software works. Operations won't use it. Finance can't see the return. Leadership wants it scrapped.",
    s1p3: "Cracking that needs someone who has sat in every one of those seats.",
    quote: "Engineer. Programmer. MBA. Founder. Operator. Client.",
    s2p1: "Gitanj has been all of them. Not as titles on a résumé, but as roles he has lived. He taught himself to program, trained as an engineer, took an MBA at XLRI, built and ran businesses, was both the employee and the employer, advised other founders, and sat on the client's side of the table, hiring specialists and living with the results.",
    s2p2: "So he reads a problem through <strong>every one of those lenses at once</strong>, watching how the pieces fit together, and where they don't.",
    s3h: "Two kinds of problem reach him.",
    s3p1: "Something is <strong>broken</strong>: money, time or quality is leaking, and what you've tried hasn't fixed it. Or nothing is broken, but it isn't <strong>growing</strong>: the business runs, yet the next move isn't obvious and the usual playbooks have stopped working.",
    s3p2: "In both, the real problem sits between disciplines, which is exactly why no single specialist has owned it. That's the shape of it. Here is the record.",
    doneH: "What he's actually done.",
    doneCaption: "A few, out of many; most stays behind closed doors.",
    done: [
      "Brought in on a government subsidy scheme leaking to fraud, he left behind a tamper-proof system that cleared 22,000+ subsidies across 5 lakh+ acres in two years.",
      "Handed the PM Gati Shakti mission's need for centimetre-accurate land maps, he orchestrated the survey that delivered 50 lakh+ sq m in six weeks.",
      "Across 20+ businesses in real estate, manufacturing, exports, education, IT and finance, he has been handed the cross-domain problems no single specialist could own.",
    ],
    whyH: "Why he does this.",
    why: [
      "Gitanj comes from a <a href=\"https://shethgroup1992.com/\" target=\"_blank\" rel=\"noopener\" class=\"font-semibold underline decoration-gold/40 underline-offset-4 transition-colors hover:text-gold\">family business group</a> worth over ₹100 crore. He doesn't take on outside problems for the fee.",
      "Years of untangling the hard problems inside his own family's businesses, and then for the people around him, taught him that an <strong>unsolved, cross-boundary problem</strong> is the one thing he can't leave alone. So he took it outside.",
      "That changes the relationship. He isn't chasing the engagement. He takes the ones worth his time, says so plainly when he can't help, and has no incentive but <strong>getting the answer right.</strong>",
    ],
    close: "Can you think of a problem Gitanj should look at?",
  },
  hi: {
    s1h: "हर विशेषज्ञ को समस्या का बस एक हिस्सा दिखता है।",
    s1p1: "टेक्नोलॉजिस्ट को टेक्नोलॉजी दिखती है। इंजीनियर को सिस्टम दिखते हैं। एमबीए को स्प्रेडशीट दिखती है। हर कोई अपनी जगह सही है, और हर किसी की नज़र अधूरी है।",
    s1p2: "सबसे मुश्किल समस्याएँ इसलिए मुश्किल नहीं होतीं कि वे पेचीदा हैं। वे इसलिए मुश्किल होती हैं क्योंकि बिज़नेस का हर हिस्सा सच का अपना-अपना वर्शन बता रहा होता है।",
    vignette: "सॉफ़्टवेयर काम कर रहा है। ऑपरेशंस उसे छूना नहीं चाहते। फ़ाइनेंस को उसमें फ़ायदा नहीं दिखता। लीडरशिप उसे बंद करना चाहती है।",
    s1p3: "इसे सुलझाने के लिए कोई ऐसा चाहिए जो इन सारी कुर्सियों पर ख़ुद बैठ चुका हो।",
    quote: "इंजीनियर। प्रोग्रामर। एमबीए। फ़ाउंडर। ऑपरेटर। क्लाइंट।",
    s2p1: "गीतांज ये सब रह चुके हैं। रेज़्यूमे के ख़िताब के तौर पर नहीं, बल्कि उन भूमिकाओं के तौर पर जो उन्होंने सचमुच जी हैं। उन्होंने ख़ुद प्रोग्रामिंग सीखी, इंजीनियर बने, XLRI से एमबीए किया, बिज़नेस खड़े किए और चलाए, कर्मचारी भी रहे और मालिक भी, दूसरे फ़ाउंडर्स को सलाह दी, और क्लाइंट की कुर्सी पर बैठकर ख़ुद विशेषज्ञों को हायर किया और उनके नतीजों के साथ जिए।",
    s2p2: "इसीलिए वे किसी समस्या को <strong>इन सारी नज़रों से एक साथ पढ़ते हैं</strong>, यह देखते हुए कि टुकड़े कहाँ जुड़ते हैं और कहाँ नहीं।",
    s3h: "उनके पास दो तरह की समस्याएँ आती हैं।",
    s3p1: "या तो कुछ <strong>टूटा हुआ</strong> है: पैसा, वक़्त या क्वालिटी रिस रही है, और जो आपने आज़माया उससे बात बनी नहीं। या फिर कुछ टूटा तो नहीं, पर <strong>बढ़ नहीं रहा</strong>: बिज़नेस चल रहा है, पर अगला कदम साफ़ नहीं है और पुराने तरीक़े काम करना बंद कर चुके हैं।",
    s3p2: "दोनों में असली समस्या अलग-अलग विषयों के बीच बैठी होती है, और ठीक इसीलिए उसे किसी एक विशेषज्ञ ने कभी अपने ज़िम्मे नहीं लिया। बस इतनी-सी बात है। अब ज़रा काम देखिए।",
    doneH: "उन्होंने असल में किया क्या है।",
    doneCaption: "बहुतों में से कुछ ही; ज़्यादातर बंद दरवाज़ों के पीछे रहता है।",
    done: [
      "धोखाधड़ी से रिसती एक सरकारी सब्सिडी योजना में उन्हें बुलाया गया, और वे पीछे एक छेड़छाड़-रोधी सिस्टम छोड़ गए जिसने दो साल में 5 लाख+ एकड़ में फैली 22,000+ सब्सिडी पास कीं।",
      "PM गति शक्ति मिशन को सरकारी ज़मीन के सेंटीमीटर-सटीक नक्शे चाहिए थे; उन्होंने वह सर्वे संभाला जिसने छह हफ़्तों में 50 लाख+ वर्ग मीटर तैयार किया।",
      "रियल एस्टेट, मैन्युफ़ैक्चरिंग, एक्सपोर्ट्स, एजुकेशन, IT और फ़ाइनेंस के 20+ बिज़नेस में उन्हें वे क्रॉस-डोमेन समस्याएँ सौंपी गईं जिन्हें कोई एक विशेषज्ञ अपने ज़िम्मे नहीं ले सकता था।",
    ],
    whyH: "वे यह करते क्यों हैं।",
    why: [
      "गीतांज ₹100 करोड़ से बड़े एक <a href=\"https://shethgroup1992.com/\" target=\"_blank\" rel=\"noopener\" class=\"font-semibold underline decoration-gold/40 underline-offset-4 transition-colors hover:text-gold\">पारिवारिक बिज़नेस समूह</a> से आते हैं। बाहर की समस्याएँ वे फ़ीस के लिए नहीं लेते।",
      "सालों तक अपने ही परिवार के बिज़नेस की मुश्किल समस्याएँ सुलझाते हुए, और फिर अपने आस-पास के लोगों के लिए, उन्होंने पाया कि एक <strong>अनसुलझी, कई विषयों में फैली समस्या</strong> ही वह चीज़ है जिसे वे छोड़ नहीं पाते। तो उन्होंने यह काम बाहर भी करना शुरू कर दिया।",
      "इससे रिश्ता ही बदल जाता है। वे काम के पीछे नहीं भागते। वही समस्याएँ लेते हैं जो उनके समय के लायक़ हों, जहाँ मदद नहीं कर सकते वहाँ साफ़ मना कर देते हैं, और उनका एकमात्र मक़सद होता है <strong>सही जवाब तक पहुँचना।</strong>",
    ],
    close: "कोई ऐसी समस्या याद आती है जो गीतांज को देखनी चाहिए?",
  },
}[locale];
---

<BaseLayout
  locale={locale}
  pagePath="gitanj-sheth"
  title={t("person.eyebrow")}
  description="Specialists each see one slice. Gitanj Sheth has been the engineer, the founder, the operator and the client, so he reads a problem through every lens at once."
>
  <!-- Header (blue) -->
  <section class="section-ink">
    <div class="container-x flex flex-col items-center gap-8 py-12 sm:flex-row sm:items-end sm:justify-between sm:gap-12 sm:pb-0 sm:pt-12 md:gap-16">
      <div class="person-copy order-2 w-full max-w-[34rem] sm:order-1 sm:w-auto sm:flex-1">
        <h1 class="person-name">{t("person.name")}</h1>
        <p class="degree-line mt-4 font-mono text-cdark" set:html={t("person.qualifications")} />
      </div>
      <div class="person-media order-1 shrink-0 self-end sm:order-2">
        <FounderPortrait alt={t("home.hero.portraitAlt")} />
      </div>
    </div>
  </section>

  <!-- 1. The challenge (ivory) -->
  <section>
    <div class="container-x grid gap-x-12 gap-y-6 py-12 md:grid-cols-[1fr_1.7fr] md:items-center md:py-16">
      <h2 class="h2">{content.s1h}</h2>
      <div class="prose-fluid space-y-6 leading-relaxed">
        <p>{content.s1p1}</p>
        <p>{content.s1p2}</p>
        <p class="vignette">{content.vignette}</p>
        <p>{content.s1p3}</p>
      </div>
    </div>
  </section>

  <!-- 2. How Gitanj addresses it (blue) -->
  <section class="section-ink">
    <div class="container-x grid gap-x-12 gap-y-8 py-12 md:grid-cols-[1.35fr_1fr] md:items-center md:py-16">
      <blockquote class="summary-quote">{content.quote}</blockquote>
      <div class="prose-fluid space-y-6 leading-relaxed">
        <p>{content.s2p1}</p>
        <p set:html={content.s2p2} />
      </div>
    </div>
  </section>

  <!-- 3. The problems he takes (ivory) -->
  <section>
    <div class="container-x grid gap-x-12 gap-y-6 py-12 md:grid-cols-[1fr_1.7fr] md:items-center md:py-16">
      <h2 class="h2">{content.s3h}</h2>
      <div class="prose-fluid space-y-6 leading-relaxed">
        <p set:html={content.s3p1} />
        <p>{content.s3p2}</p>
      </div>
    </div>
  </section>

  <!-- 4. Proof (blue) -->
  <section class="section-ink">
    <div class="container-x grid gap-x-12 gap-y-4 py-12 md:grid-cols-[1fr_1.7fr] md:items-center md:py-16">
      <div>
        <h2 class="h2">{content.doneH}</h2>
        <p class="prose-fluid mt-4 italic">{content.doneCaption}</p>
      </div>
      <ul class="done-list prose-fluid">
        {content.done.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </section>

  <!-- 5. Why he does this (ivory) -->
  <section>
    <div class="container-x grid gap-x-12 gap-y-6 py-12 md:grid-cols-[1fr_1.7fr] md:items-center md:py-16">
      <h2 class="h2">{content.whyH}</h2>
      <div class="prose-fluid space-y-6 leading-relaxed">
        {content.why.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <!-- Close (ivory), split from 'Why' by a content-width hairline -->
  <section>
    <div class="container-x">
      <div class="border-t border-ink/10"></div>
      <div class="py-16">
        <p class="close-q">{content.close}</p>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  /* One fluid body scale for all copy: 16px @375 -> 19px @1280. */
  .prose-fluid {
    font-size: clamp(1rem, 0.922rem + 0.33vw, 1.1875rem);
  }

  .summary-quote {
    margin: 0;
    font-family: theme("fontFamily.display");
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.12;
    font-size: clamp(1.75rem, 1.2rem + 2.3vw, 3.25rem); /* 28 -> 52 */
    padding-left: 1.25rem;
    border-left: 3px solid var(--gold);
  }

  /* Delivered-work list: only a 1rem padding between points, no extra gap. */
  .done-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .done-list li {
    line-height: 1.55;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .done-list li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .vignette {
    padding-left: 1.25rem;
    border-left: 2px solid var(--gold);
    font-style: italic;
  }

  .close-q {
    font-family: theme("fontFamily.display");
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    font-size: clamp(1.5rem, 1.05rem + 2vw, 2.5rem); /* 24 -> 40 */
  }
</style>
