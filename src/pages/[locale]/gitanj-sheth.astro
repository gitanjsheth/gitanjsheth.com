---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FounderPortrait from "../../components/FounderPortrait.astro";
import CtaBand from "../../components/CtaBand.astro";
import { localeStaticPaths, useTranslations, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

// English-only for now (hardcoded); moves to i18n once locked.
const done = [
  "Brought in on a government subsidy scheme leaking to fraud, he left behind a tamper-proof system that cleared 22,000+ subsidies across 5 lakh+ acres in two years.",
  "Handed the PM Gati Shakti mission's need for centimetre-accurate land maps, he orchestrated the survey that delivered 50 lakh+ sq m in six weeks.",
  "Across 20+ businesses in real estate, manufacturing, exports, education, IT and finance, he has been handed the cross-domain problems no single specialist could own.",
];
---

<BaseLayout
  locale={locale}
  pagePath="gitanj-sheth"
  title={t("person.eyebrow")}
  description="Specialists each see one slice. Gitanj Sheth has been the engineer, the founder, the operator and the client, so he reads a problem through every lens at once."
>
  <!-- Header: name + qualifications + portrait (blue) -->
  <section class="section-ink">
    <div class="container-x flex flex-col items-center gap-8 py-12 sm:flex-row sm:items-end sm:justify-between sm:gap-12 sm:pb-0 sm:pt-12 md:gap-16">
      <div class="person-copy order-2 w-full max-w-[34rem] sm:order-1 sm:w-auto sm:flex-1">
        <h1 class="person-name">{t("person.name")}</h1>
        <p class="prose-fluid mt-4 font-mono text-ivory">{t("person.qualifications")}</p>
      </div>
      <div class="person-media order-1 shrink-0 self-end sm:order-2">
        <FounderPortrait alt={t("home.hero.portraitAlt")} />
      </div>
    </div>
  </section>

  <!-- 1. The challenge (ivory) -->
  <section>
    <div class="container-x grid gap-x-12 gap-y-6 py-12 md:grid-cols-[1fr_1.7fr] md:py-16">
      <h2 class="h2">Specialists each see one slice.</h2>
      <div class="prose-fluid space-y-6 leading-relaxed">
        <p>
          The technologist sees the technology. The engineer sees the systems. The MBA sees the
          spreadsheet. Each of them is right, and each of them is partial.
        </p>
        <p>
          The hardest problems aren't hard because they're complicated. They're hard because each part
          of the business is telling a different version of the truth. Technology says one thing,
          operations another, finance a third, leadership a fourth.
        </p>
        <p class="vignette">
          The software works. Operations won't use it. Finance can't see the return. Leadership wants
          it scrapped. Everyone is partly right, and nothing moves.
        </p>
        <p>Cracking that needs someone who has sat in every one of those seats.</p>
      </div>
    </div>
  </section>

  <!-- 2. How Gitanj addresses it (blue) — the roles quote lands here, as the answer -->
  <section class="section-ink">
    <div class="container-x grid gap-x-12 gap-y-8 py-12 md:grid-cols-[1.35fr_1fr] md:py-16">
      <blockquote class="summary-quote md:self-center">Engineer. Programmer. MBA. Founder. Operator. Client.</blockquote>
      <div class="prose-fluid space-y-6 leading-relaxed md:self-center">
        <p>
          Gitanj has been all of them. Not as titles on a résumé, but as roles he has lived. He taught
          himself to program, trained as an engineer, took an MBA at XLRI, built and ran businesses, was
          both the employee and the employer, advised other founders, and sat on the client's side of
          the table, hiring specialists and living with the results.
        </p>
        <p>
          So he reads a problem through every one of those lenses at once, watching how the pieces fit
          together, and where they don't.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. The problems he takes (ivory) -->
  <section>
    <div class="container-x grid gap-x-12 gap-y-6 py-12 md:grid-cols-[1fr_1.7fr] md:py-16">
      <h2 class="h2">Two kinds of problem reach him.</h2>
      <div class="prose-fluid space-y-6 leading-relaxed">
        <p>
          Something is <strong>broken</strong>: money, time or quality is leaking, and what you've tried
          hasn't fixed it. Or nothing is broken, but it isn't <strong>growing</strong>: the business
          runs, yet the next move isn't obvious and the usual playbooks have stopped working.
        </p>
        <p>
          In both, the real problem sits between disciplines, which is exactly why no single specialist
          has owned it. That's the shape of it. Here is the record.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. Proof (blue) -->
  <section class="section-ink">
    <div class="container-x grid gap-x-12 gap-y-6 py-12 md:grid-cols-[1fr_1.7fr] md:py-16">
      <div>
        <h2 class="h2">What he's actually done.</h2>
        <p class="prose-fluid mt-4 italic">None of it is a pitch. A few, out of many; most stays behind closed doors.</p>
      </div>
      <ul class="done-list prose-fluid">
        {done.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </section>

  <!-- 5. Why he does this (ivory) — the last hook -->
  <section>
    <div class="container-x grid gap-x-12 gap-y-6 py-12 md:grid-cols-[1fr_1.7fr] md:py-16">
      <h2 class="h2">Why he does this.</h2>
      <div class="prose-fluid space-y-6 leading-relaxed">
        <p>
          Gitanj comes from a family business group worth over ₹100 crore. He doesn't take on outside
          problems for the fee.
        </p>
        <p>
          Years of untangling the hard problems inside his own family's businesses, and then for the
          people around him, taught him that an unsolved, cross-boundary problem is the one thing he
          can't leave alone. So he took it outside.
        </p>
        <p>
          That changes the relationship. He isn't chasing the engagement. He takes the ones worth his
          time, says so plainly when he can't help, and has no incentive but getting the answer right.
        </p>
      </div>
    </div>
  </section>

  <!-- Close: open question (ivory), split from 'Why' by a subtle line -->
  <section class="border-t border-ink/10">
    <div class="container-x py-16 md:py-24">
      <p class="close-q">Can you think of a problem Gitanj should look at?</p>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  /* One fluid body scale for all copy on this page: 16px @375 -> 19px @1280. */
  .prose-fluid {
    font-size: clamp(1rem, 0.922rem + 0.33vw, 1.1875rem);
  }

  /* Summary quote — the showcase line (fills its column, fluid). */
  .summary-quote {
    margin: 0;
    font-family: theme("fontFamily.display");
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.12;
    font-size: clamp(1.75rem, 1.2rem + 2.3vw, 3.25rem); /* 28 -> 52 */
    padding-left: 1.25rem;
    border-left: 3px solid var(--gold);
  }

  /* Delivered-work list. */
  .done-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .done-list li {
    line-height: 1.55;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }

  /* Set-off scenario. */
  .vignette {
    padding-left: 1.25rem;
    border-left: 2px solid var(--gold);
    font-style: italic;
  }

  /* Closing question — fluid, sized to sit on one line at desktop. */
  .close-q {
    font-family: theme("fontFamily.display");
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-size: clamp(1.5rem, 1.05rem + 2vw, 2.5rem); /* 24 -> 40 */
  }
</style>
