---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FounderPortrait from "../../components/FounderPortrait.astro";
import TestimonialsCarousel from "../../components/TestimonialsCarousel.astro";
import ExpertsCarousel from "../../components/ExpertsCarousel.astro";
import CtaBand from "../../components/CtaBand.astro";
import {
  localeStaticPaths,
  localizePath,
  useTranslations,
  type Locale,
} from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

const testimonials = (await getCollection("testimonials"))
  .filter((x) => x.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const experts = (await getCollection("experts")).sort(
  (a, b) => a.data.order - b.data.order
);

const trackRecord: { value: string; label: string }[] = t("person.trackRecord");
---

<BaseLayout locale={locale} pagePath="home" title="" description={t("site.description")}>
  <!-- 1. HERO (ivory) -->
  <section>
    <div class="container-x py-12 text-center md:py-20">
      <h1 class="mx-auto max-w-4xl h1">
        {t("home.hero.title")}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">{t("home.hero.subtitle")}</p>
      <div class="mt-8 flex justify-center">
        <a href={localizePath(locale, "contact")} class="btn btn-primary">
          {t("home.hero.cta")}
        </a>
      </div>
    </div>
  </section>

  <!-- 2. THE PRINCIPAL (blue) -->
  <section id="person" class="scroll-mt-24 section-ink">
    <div class="container-x py-10 md:py-16">
      <!-- Mobile: portrait first (face-first). Desktop: text left, portrait
           right-aligned to the content edge. -->
      <!-- Text + portrait as a balanced, centred PAIR. The columns are capped
           (not fr units) and the grid is centre-justified, so the text stays a
           readable width and the portrait sits right beside it — no dead gap
           opening between them on wide screens. Two-up from 640px; below that
           the portrait leads (face-first) full width. -->
      <div class="flex flex-col items-center gap-8 sm:flex-row sm:justify-center sm:gap-12 md:gap-16">
        <div class="order-2 w-full max-w-[34rem] sm:order-1 sm:w-auto sm:flex-1">
          <h2 class="h2">{t("person.name")}</h2>
          <p class="mt-6 lead">{t("person.lead")}</p>
          <p class="mt-4 text-ivory/80">{t("person.combination")}</p>
        </div>
        <div class="person-media order-1 shrink-0 sm:order-2">
          <FounderPortrait alt={t("home.hero.portraitAlt")} />
        </div>
      </div>

      <dl class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          trackRecord.map((tr) => (
            <div class="border-t border-ivory/15 pt-4">
              <dt class="font-display text-2xl leading-none">{tr.value}</dt>
              <dd class="mt-2 text-sm text-ivory/70">{tr.label}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-10 border-t border-ivory/15 pt-8">
        <div class="measure">
          <p>{t("person.education")}</p>
          <p class="mt-3">{t("person.roles")}</p>
        </div>
        <div class="mt-8 flex justify-center">
          <a href={localizePath(locale, "gitanj-sheth")} class="btn btn-reversed">
            {t("person.more")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. THE FIRM (ivory) -->
  <section id="story" class="scroll-mt-24">
    <div class="container-x py-10 md:py-16">
      <div class="grid gap-6 md:grid-cols-[1fr_1.6fr] md:gap-10">
        <div>
          <h2 class="h2">{t("home.story.title")}</h2>
        </div>
        <div class="measure text-lg text-muted">
          <p>{t("home.story.teaser")}</p>
        </div>
      </div>
      <div class="mt-8 flex justify-center">
        <a href={localizePath(locale, "our-story")} class="btn btn-ghost">
          {t("home.story.more")}
        </a>
      </div>
    </div>
  </section>

  <!-- 4. SERVICES (blue) -->
  <section id="solutions" class="scroll-mt-24 section-ink">
    <div class="container-x py-10 md:py-16">
      <div class="max-w-2xl">
        <h2 class="h2">{t("solutions.title")}</h2>
        <p class="mt-4 measure text-ivory/70">{t("solutions.intro")}</p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          [
            { k: "repair", n: "01" },
            { k: "boost", n: "02" },
          ].map(({ k, n }) => (
            <div class="card flex flex-col p-8 md:p-10">
              <div class="flex items-baseline justify-between">
                <h3 class="h3">{t(`solutions.${k}.label`)}</h3>
                <span class="font-mono text-sm text-gold">{n}</span>
              </div>
              <p class="mt-4 text-lg leading-relaxed text-muted">{t(`solutions.${k}.body`)}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 flex justify-center">
        <a href={localizePath(locale, "case-studies")} class="btn btn-reversed">
          {t("solutions.casesLink")}
        </a>
      </div>
    </div>
  </section>

  <!-- 5. THE EXPERTS (ivory) -->
  {
    experts.length > 0 && (
      <section class="scroll-mt-24">
        <div class="container-x pt-10 md:pt-16">
          <div class="max-w-2xl">
            <h2 class="h2">{t("home.experts.title")}</h2>
          </div>
        </div>
        <div class="mt-8 md:mt-10">
          <ExpertsCarousel locale={locale} items={experts} />
        </div>
        <div class="container-x flex justify-center pt-8 pb-10 md:pb-16">
          <a href={localizePath(locale, "experts")} class="btn btn-ghost">
            {t("home.experts.viewAll")}
          </a>
        </div>
      </section>
    )
  }

  <!-- 6. HOW WE ENGAGE (blue) -->
  <section id="how-we-engage" class="scroll-mt-24 section-ink">
    <div class="container-x py-10 md:py-16">
      <div class="grid gap-6 md:grid-cols-[1fr_1.6fr] md:gap-10">
        <div>
          <h2 class="h2">{t("engageHome.title")}</h2>
        </div>
        <div class="measure">
          <p class="text-lg">{t("engageHome.body")}</p>
        </div>
      </div>
      <div class="mt-8 flex justify-center">
        <a href={localizePath(locale, "how-we-engage")} class="btn btn-reversed">
          {t("engageHome.more")}
        </a>
      </div>
    </div>
  </section>

  <!-- 7. TESTIMONIALS (ivory) -->
  <section id="testimonials" class="scroll-mt-24">
    <div class="container-x pt-10 md:pt-16">
      <div class="max-w-2xl">
        <h2 class="h2">{t("testimonialsHome.title")}</h2>
      </div>
    </div>
    <div class="mt-8 pb-6 md:mt-10">
      <TestimonialsCarousel locale={locale} items={testimonials} />
    </div>
    <div class="container-x flex justify-center pb-10 md:pb-16">
      <a href={localizePath(locale, "testimonials")} class="btn btn-ghost">
        {t("testimonialsHome.viewAll")}
      </a>
    </div>
  </section>

  <!-- 8. ENQUIRY CTA BAND (blue) -->
  <CtaBand locale={locale} />
</BaseLayout>
