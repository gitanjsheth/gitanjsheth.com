---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FounderPortrait from "../../components/FounderPortrait.astro";
import TestimonialsCarousel from "../../components/TestimonialsCarousel.astro";
import ExpertsCarousel from "../../components/ExpertsCarousel.astro";
import {
  localeStaticPaths,
  localizePath,
  useTranslations,
  type Locale,
} from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

const testimonials = (await getCollection("testimonials"))
  .filter((x) => x.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const experts = (await getCollection("experts")).sort(
  (a, b) => a.data.order - b.data.order
);

const trackRecord: { value: string; label: string }[] = t("person.trackRecord");
---

<BaseLayout locale={locale} pagePath="home" title="" description={t("site.description")}>
  <!-- HERO — a clean typographic statement (no stock-feeling portrait). -->
  <section class="section-ink">
    <div class="container-x py-20 text-center md:py-32">
      <h1 class="mx-auto max-w-4xl font-display" style="font-size:clamp(2.5rem,6vw,4.75rem);line-height:1.05;">
        {t("home.hero.title")}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-ivory/80">{t("home.hero.subtitle")}</p>
      <div class="mt-9 flex justify-center">
        <a href={localizePath(locale, "contact")} class="btn btn-reversed">
          {t("home.hero.cta")}
        </a>
      </div>
    </div>
  </section>

  <!-- THE PRINCIPAL — Gitanj, now shown WITH his name so the portrait reads as him. -->
  <section id="person" class="scroll-mt-24">
    <div class="container-x py-14 md:py-28">
      <div class="grid items-center gap-8 md:grid-cols-[0.8fr_1.2fr] md:gap-14">
        <div class="mx-auto w-full max-w-xs sm:max-w-sm">
          <FounderPortrait alt={t("home.hero.portraitAlt")} />
        </div>
        <div>
          <h2 class="text-3xl md:text-5xl">{t("person.name")}</h2>
          <p class="mt-6 text-xl leading-relaxed measure">{t("person.lead")}</p>
          <p class="mt-4 text-muted measure">{t("person.combination")}</p>
        </div>
      </div>

      <!-- Proof-of-calibre: numbers + institutions, scannable. -->
      <dl class="mt-14 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          trackRecord.map((tr) => (
            <div class="border-t border-ink/12 pt-4">
              <dt class="font-display text-2xl leading-none">{tr.value}</dt>
              <dd class="mt-2 text-sm text-muted">{tr.label}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-12 border-t border-ink/12 pt-8">
        <div class="measure">
          <p class="text-sm">{t("person.education")}</p>
          <p class="mt-4 text-sm">{t("person.roles")}</p>
        </div>
        <div class="mt-8 flex justify-center">
          <a href={localizePath(locale, "gitanj-sheth")} class="btn btn-ghost">
            {t("person.more")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- THE FIRM (teaser → dedicated /our-story page) -->
  <section id="story" class="scroll-mt-24 section-ink">
    <div class="container-x py-14 md:py-24">
      <div class="grid gap-6 md:grid-cols-[1fr_1.6fr] md:gap-10">
        <div>
          <h2 class="text-3xl md:text-4xl">{t("home.story.title")}</h2>
        </div>
        <div class="measure text-lg text-ivory/85">
          <p>{t("home.story.teaser")}</p>
        </div>
      </div>
      <div class="mt-8 flex justify-center">
        <a href={localizePath(locale, "our-story")} class="btn btn-reversed">
          {t("home.story.more")}
        </a>
      </div>
    </div>
  </section>

  <!-- REPAIR / BOOST — two open boxes -->
  <section id="solutions" class="scroll-mt-24">
    <div class="container-x py-14 md:py-28">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-4xl">{t("solutions.title")}</h2>
        <p class="mt-4 text-muted measure">{t("solutions.intro")}</p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          [
            { k: "repair", n: "01" },
            { k: "boost", n: "02" },
          ].map(({ k, n }) => (
            <div class="card flex flex-col p-8 md:p-10">
              <div class="flex items-baseline justify-between">
                <h3 class="text-2xl md:text-3xl">{t(`solutions.${k}.label`)}</h3>
                <span class="font-mono text-sm text-gold">{n}</span>
              </div>
              <p class="mt-4 text-lg leading-relaxed text-muted">{t(`solutions.${k}.body`)}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex justify-center">
        <a href={localizePath(locale, "case-studies")} class="btn btn-ghost">
          {t("solutions.casesLink")}
        </a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS CAROUSEL (dark, so white cards pop and the rhythm alternates) -->
  <section id="testimonials" class="scroll-mt-24 section-ink">
    <div class="container-x pt-14 md:pt-28">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-4xl">{t("testimonialsHome.title")}</h2>
      </div>
    </div>
    <div class="mt-10 pb-6 md:mt-12">
      <TestimonialsCarousel locale={locale} items={testimonials} />
    </div>
    <div class="container-x flex justify-center pb-14 md:pb-28">
      <a href={localizePath(locale, "testimonials")} class="btn btn-reversed">
        {t("testimonialsHome.viewAll")}
      </a>
    </div>
  </section>

  <!-- THE EXPERTS (carousel teaser → /experts) -->
  {
    experts.length > 0 && (
      <section class="scroll-mt-24">
        <div class="container-x pt-14 md:pt-24">
          <div class="max-w-2xl">
            <h2 class="text-3xl md:text-4xl">{t("home.experts.title")}</h2>
          </div>
        </div>
        <div class="mt-10 md:mt-12">
          <ExpertsCarousel locale={locale} items={experts} />
        </div>
        <div class="container-x flex justify-center pt-10 pb-14 md:pb-24">
          <a href={localizePath(locale, "experts")} class="btn btn-ghost">
            {t("home.experts.viewAll")}
          </a>
        </div>
      </section>
    )
  }

  <!-- HOW WE ENGAGE (teaser) -->
  <section id="how-we-engage" class="scroll-mt-24 border-t border-ink/10">
    <div class="container-x py-14 md:py-24">
      <div class="grid gap-6 md:grid-cols-[1fr_1.6fr] md:gap-10">
        <div>
          <h2 class="text-3xl md:text-4xl">{t("engageHome.title")}</h2>
        </div>
        <div class="measure">
          <p class="text-lg">{t("engageHome.body")}</p>
        </div>
      </div>
      <div class="mt-8 flex justify-center">
        <a href={localizePath(locale, "how-we-engage")} class="btn btn-ghost">
          {t("engageHome.more")}
        </a>
      </div>
    </div>
  </section>

  <!-- ENQUIRY CTA BAND -->
  <section class="section-ink border-t border-gold/30">
    <div class="container-x py-14 text-center md:py-24">
      <h2 class="mx-auto max-w-3xl text-3xl md:text-4xl">{t("ctaBand.title")}</h2>
      <p class="mx-auto mt-4 max-w-xl text-ivory/80">{t("ctaBand.subtitle")}</p>
      <div class="mt-8 flex justify-center">
        <a href={localizePath(locale, "contact")} class="btn btn-reversed">
          {t("ctaBand.button")}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
