---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { localizePath, useTranslations, type Locale } from "../../i18n/utils";
import { localeStaticPaths } from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const points: { heading: string; body: string }[] = t("engage.points");
---

<BaseLayout locale={locale} pagePath="how-we-engage" title={t("engage.title")} description={t("engage.intro")}>
  <section>
    <div class="container-x pt-10 md:pt-16 pb-8 md:pb-10">
      <h1 class="h1">{t("engage.title")}</h1>
      <p class="mt-5 max-w-3xl text-lg text-muted">{t("engage.intro")}</p>
    </div>
  </section>

  <section class="border-t border-ink/10">
    <div class="container-x pt-8 md:pt-10 pb-10 md:pb-16">
      <ol class="grid gap-x-12 gap-y-12 md:grid-cols-2">
        {
          points.map((p, i) => (
            <li class="grid grid-cols-[auto_1fr] gap-5">
              <span class="font-display text-3xl text-gold leading-none">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h2 class="text-xl">{p.heading}</h2>
                <p class="mt-2 text-muted">{p.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>
