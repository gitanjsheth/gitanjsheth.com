---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { useTranslations, type Locale } from "../../i18n/utils";
import { localeStaticPaths } from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const flow: string[] = t("engage.flow");
const notes: string[] = t("engage.notes");
---

<BaseLayout locale={locale} pagePath="how-we-engage" title={t("engage.title")} description={t("engage.intro")}>
  <section>
    <div class="container-x pt-10 md:pt-16 pb-8 md:pb-10">
      <h1 class="h1">{t("engage.title")}</h1>
      <p class="mt-5 max-w-3xl text-lg text-muted">{t("engage.intro")}</p>
    </div>
  </section>

  <section class="border-t border-ink/10">
    <div class="container-x pt-8 md:pt-10 pb-10 md:pb-16">
      <!-- The journey, told as a flow. -->
      <div class="measure space-y-6 text-lg leading-relaxed">
        {flow.map((para) => <p>{para}</p>)}
      </div>

      <!-- Practical notes, kept apart from the story above. -->
      <div class="mt-12 max-w-2xl md:mt-16">
        <h2 class="text-xl">{t("engage.notesHeading")}</h2>
        <ul class="mt-5 space-y-4">
          {
            notes.map((note) => (
              <li class="grid grid-cols-[auto_1fr] gap-3 text-muted">
                <span class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true" />
                <span>{note}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>
