---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localizePath, useTranslations, type Locale } from "../../i18n/utils";
import { localeStaticPaths } from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const points: { heading: string; body: string }[] = t("engage.points");
---

<BaseLayout locale={locale} pagePath="how-we-engage" title={t("engage.title")} description={t("engage.intro")}>
  <section>
    <div class="container-x py-16 md:py-24">
      <p class="eyebrow">{t("nav.howWeEngage")}</p>
      <h1 class="mt-4 text-4xl md:text-5xl">{t("engage.title")}</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted measure">{t("engage.intro")}</p>
    </div>
  </section>

  <section class="border-t border-ink/10">
    <div class="container-x py-14 md:py-20">
      <ol class="grid gap-x-12 gap-y-12 md:grid-cols-2">
        {
          points.map((p, i) => (
            <li class="grid grid-cols-[auto_1fr] gap-5">
              <span class="font-display text-3xl text-gold leading-none">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h2 class="text-xl">{p.heading}</h2>
                <p class="mt-2 text-muted measure">{p.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section-ink">
    <div class="container-x py-16 text-center md:py-20">
      <h2 class="mx-auto max-w-2xl text-2xl md:text-3xl">{t("home.ctaBand.title")}</h2>
      <div class="mt-8">
        <a href={localizePath(locale, "contact") + "#enquire"} class="btn btn-reversed">
          {t("home.ctaBand.button")}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
