---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { localizePath, useTranslations, type Locale } from "../../i18n/utils";
import { localeStaticPaths } from "../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const body: string[] = t("ourStory.body");
---

<BaseLayout locale={locale} pagePath="our-story" title={t("ourStory.eyebrow")} description={t("ourStory.intro")}>
  <section>
    <div class="container-x pt-10 md:pt-16 pb-8 md:pb-10">
      <h1 class="h1">{t("ourStory.title")}</h1>
      <p class="mt-5 text-lg text-muted">{t("ourStory.intro")}</p>
    </div>
  </section>

  <section>
    <div class="container-x">
      <!-- Hairline inset to the content width, not bled to the viewport edge. -->
      <div class="border-t border-ink/10"></div>
      <div class="space-y-6 pt-8 text-lg leading-relaxed md:pt-10 pb-10 md:pb-16">
        {body.map((para) => <p>{para}</p>)}
        <div class="flex justify-center pt-4">
          <a href={localizePath(locale, "how-we-engage")} class="btn btn-ghost">
            {t("ourStory.more")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>
