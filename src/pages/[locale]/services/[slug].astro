---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  locales,
  localizePath,
  useTranslations,
  type Locale,
} from "../../../i18n/utils";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return locales.flatMap((locale) =>
    services.map((service) => ({
      params: { locale, slug: service.id },
      props: { locale, service },
    }))
  );
}

const { locale, service } = Astro.props as {
  locale: Locale;
  service: CollectionEntry<"services">;
};
const t = useTranslations(locale);
const d = service.data;
const pagePath = `services/${service.id}`;
---

<BaseLayout
  locale={locale}
  pagePath={pagePath}
  title={d.title[locale]}
  description={d.symptomLine[locale]}
>
  <article>
    <section class="section-ink">
      <div class="container-x py-16 md:py-24">
        <a href={localizePath(locale, "services")} class="link text-sm text-ivory/70">
          &larr; {t("services.backToAll")}
        </a>
        <p class="eyebrow mt-8">{d.discipline[locale]}</p>
        <h1 class="mt-4 max-w-3xl text-4xl md:text-5xl">{d.title[locale]}</h1>
        <p class="mt-6 max-w-2xl text-lg text-ivory/80 measure">{d.symptomLine[locale]}</p>
      </div>
    </section>

    <section>
      <div class="container-x py-16 md:py-20">
        <p class="max-w-3xl text-lg leading-relaxed measure">{d.description[locale]}</p>
        <div class="mt-10">
          <a href={localizePath(locale, "contact") + "#enquire"} class="btn btn-primary">
            {t("services.detailCta")}
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
