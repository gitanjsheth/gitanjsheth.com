---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  localeStaticPaths,
  localizePath,
  useTranslations,
  type Locale,
} from "../../../i18n/utils";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

const categoryOrder = ["flagship", "strategy", "technology", "operations", "finance"] as const;
const all = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const byCategory = categoryOrder.map((cat) => ({
  cat,
  label: t(`serviceCategories.${cat}`),
  items: all.filter((s) => s.data.category === cat),
}));
---

<BaseLayout locale={locale} pagePath="services" title={t("services.title")} description={t("services.intro")}>
  <section>
    <div class="container-x py-16 md:py-24">
      <p class="eyebrow">{t("home.services.label")}</p>
      <h1 class="mt-4 text-4xl md:text-5xl">{t("services.title")}</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted measure">{t("services.intro")}</p>
    </div>
  </section>

  {
    byCategory.map(({ cat, label, items }) => (
      <section class="border-t border-ink/10">
        <div class="container-x py-14 md:py-20">
          <h2 class="eyebrow text-gold">{label}</h2>
          <div class="mt-8 grid gap-x-10 gap-y-12 md:grid-cols-2">
            {items.map((s) => (
              <article id={s.id} class="scroll-mt-24">
                <p class="text-xs uppercase tracking-caps text-muted">{s.data.discipline[locale]}</p>
                <h3 class="mt-2 text-2xl">{s.data.title[locale]}</h3>
                <p class="mt-3 text-muted measure">{s.data.description[locale]}</p>
                <a
                  href={localizePath(locale, "contact") + "#enquire"}
                  class="link mt-4 inline-block text-sm"
                >
                  {t("services.detailCta")} &rarr;
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section-ink">
    <div class="container-x py-16 text-center md:py-20">
      <h2 class="mx-auto max-w-2xl text-2xl md:text-3xl">{t("home.ctaBand.title")}</h2>
      <div class="mt-8">
        <a href={localizePath(locale, "contact") + "#enquire"} class="btn btn-reversed">
          {t("home.ctaBand.button")}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
