---
/**
 * Bare-root language gate ("/").
 *
 * Holds NO content — it only routes the visitor into a locale:
 *  - Return visits: an inline <head> script reads the stored locale and
 *    redirects to /{locale}/home BEFORE paint, so the gate never flashes.
 *  - First visit: a full-screen blocking interstitial, English pre-selected.
 *    On choice we persist the locale (cookie + localStorage) and route on.
 *  - No-JS: plain links to both locales are always present.
 */
import "../styles/global.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-mono/400.css";
import "@fontsource/inter/400.css";
import "@fontsource-variable/anek-devanagari/wght.css";
import Logo from "../components/Logo.astro";
import { getStrings, defaultLocale } from "../i18n/utils";
import { LOCALE_STORAGE_KEY } from "../config";

const en = getStrings("en");
const hi = getStrings("hi");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const knownLocales = ["en", "hi"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{en.site.name} — {en.site.tagline}</title>
    <meta name="description" content={en.site.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <meta name="theme-color" content="#16233B" />
    <!-- Point crawlers at the canonical English home; both locales are in the sitemap. -->
    <link rel="canonical" href="https://gitanjsheth.com/en/home" />

    <!-- Instant redirect for return visitors, before anything renders. -->
    <script is:inline define:vars={{ key: LOCALE_STORAGE_KEY, base, knownLocales }}>
      (function () {
        try {
          var stored = localStorage.getItem(key);
          if (!stored) {
            var m = document.cookie.match(new RegExp("(?:^|; )" + key + "=([^;]+)"));
            if (m) stored = decodeURIComponent(m[1]);
          }
          if (stored && knownLocales.indexOf(stored) !== -1) {
            location.replace(base + "/" + stored + "/home");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main class="gate" id="gate">
      <div class="gate__card">
        <Logo variant="ink" showText={true} class="gate__logo" />

        <h1 class="gate__heading">
          <span lang="en">{en.gate.heading}</span>
          <span class="gate__heading-sep" aria-hidden="true"> / </span>
          <span lang="hi">{hi.gate.heading}</span>
        </h1>

        <form class="gate__form" id="gate-form">
          <fieldset class="gate__options">
            <legend class="sr-only-focusable">Choose your language / भाषा चुनें</legend>

            <label class="gate__option" data-option>
              <input type="radio" name="locale" value="en" checked />
              <span class="gate__option-label" lang="en">{en.gate.english}</span>
            </label>

            <label class="gate__option" data-option>
              <input type="radio" name="locale" value="hi" />
              <span class="gate__option-label" lang="hi">{hi.gate.hindi}</span>
            </label>
          </fieldset>

          <button type="submit" class="btn btn-primary gate__continue">
            <span lang="en">{en.gate.continue}</span>
            <span aria-hidden="true"> · </span>
            <span lang="hi">{hi.gate.continue}</span>
          </button>
        </form>

        <p class="gate__hint">
          <span lang="en">{en.gate.hint}</span>
        </p>

        <!-- No-JS fallback -->
        <noscript>
          <div class="gate__noscript">
            <a href={`${base}/en/home`} class="link">English</a>
            <span aria-hidden="true"> / </span>
            <a href={`${base}/hi/home`} class="link" lang="hi">हिन्दी</a>
          </div>
        </noscript>
      </div>
    </main>

    <script is:inline define:vars={{ key: LOCALE_STORAGE_KEY, base, defaultLocale }}>
      (function () {
        var form = document.getElementById("gate-form");
        if (!form) return;

        function persistAndGo(loc) {
          try {
            localStorage.setItem(key, loc);
          } catch (e) {}
          document.cookie = key + "=" + loc + "; path=/; max-age=31536000; samesite=lax";
          location.href = base + "/" + loc + "/home";
        }

        // Visual selected state.
        var options = form.querySelectorAll("[data-option]");
        function refresh() {
          options.forEach(function (opt) {
            var input = opt.querySelector("input");
            opt.setAttribute("data-selected", input && input.checked ? "true" : "false");
          });
        }
        form.addEventListener("change", refresh);
        refresh();

        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var checked = form.querySelector('input[name="locale"]:checked');
          persistAndGo(checked ? checked.value : defaultLocale);
        });
      })();
    </script>

    <style>
      .gate {
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: 2rem 1.5rem;
        background: radial-gradient(
          120% 120% at 50% 0%,
          #f9f5ec 0%,
          var(--ivory) 55%,
          #efe7d6 100%
        );
      }
      .gate__card {
        width: 100%;
        max-width: 30rem;
        text-align: center;
      }
      .gate__logo {
        justify-content: center;
      }
      .gate__heading {
        margin-top: 2rem;
        font-size: clamp(1.5rem, 4vw, 2.1rem);
        font-weight: 500;
        line-height: 1.25;
      }
      .gate__heading-sep {
        color: var(--gold);
        font-weight: 400;
      }
      .gate__form {
        margin-top: 2.25rem;
      }
      .gate__options {
        border: 0;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.75rem;
        grid-template-columns: 1fr 1fr;
      }
      .gate__option {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
        border-radius: 4px;
        background: var(--paper);
        cursor: pointer;
        transition: border-color 250ms ease, box-shadow 250ms ease;
      }
      .gate__option input {
        position: absolute;
        opacity: 0;
        inset: 0;
        cursor: pointer;
      }
      .gate__option[data-selected="true"] {
        border-color: var(--gold);
        box-shadow: inset 0 0 0 1px var(--gold);
      }
      .gate__option-label {
        font-size: 1.05rem;
      }
      .gate__continue {
        margin-top: 1.25rem;
        width: 100%;
      }
      .gate__hint {
        margin-top: 1.25rem;
        font-size: 0.8rem;
        color: var(--muted);
      }
      .gate__noscript {
        margin-top: 1.25rem;
      }
    </style>
  </body>
</html>
