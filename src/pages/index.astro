---
/**
 * Bare-root language gate ("/").
 *
 * Return visits: an inline <head> script reads the stored locale and redirects
 * to /{locale}/home BEFORE paint, so the gate never flashes.
 *
 * First visit: a limited modal card over a blurred live preview of the English
 * home. Choosing a language (or clicking the blurred backdrop) persists the
 * locale and routes on — backdrop click defaults to English.
 */
import "../styles/global.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-mono/400.css";
import "@fontsource/inter/400.css";
import "@fontsource-variable/noto-sans-devanagari/wght.css";
import Logo from "../components/Logo.astro";
import { getStrings, defaultLocale } from "../i18n/utils";
import { LOCALE_STORAGE_KEY } from "../config";

const en = getStrings("en");
const hi = getStrings("hi");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const knownLocales = ["en", "hi"];
const homePreview = `${base}/en/home`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{en.site.name} — {en.site.tagline}</title>
    <meta name="description" content={en.site.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <meta name="theme-color" content="#16233B" />
    <link rel="canonical" href="https://gitanjsheth.com/en/home" />

    <script is:inline define:vars={{ key: LOCALE_STORAGE_KEY, base, knownLocales }}>
      (function () {
        try {
          // Cookie is the source of truth, so clearing cookies re-shows the
          // gate (localStorage would otherwise survive a cookie wipe).
          var stored = null;
          var m = document.cookie.match(new RegExp("(?:^|; )" + key + "=([^;]+)"));
          if (m) stored = decodeURIComponent(m[1]);
          if (stored && knownLocales.indexOf(stored) !== -1) {
            location.replace(base + "/" + stored + "/home");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="gate-body">
    <!-- Live home preview (blurred, non-interactive). Clicking the backdrop = English. -->
    <div class="gate-backdrop" id="gate-backdrop" role="presentation" aria-hidden="true">
      <iframe
        class="gate-preview"
        src={homePreview}
        title=""
        tabindex="-1"
        loading="eager"
      ></iframe>
      <div class="gate-scrim"></div>
    </div>

    <div
      class="gate-card"
      id="gate-card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="gate-heading"
    >
      <Logo variant="ink" showText={true} class="gate__logo" />

      <h1 class="gate__heading" id="gate-heading">
        <span lang="en">{en.gate.heading}</span>
        <span class="gate__heading-sep" aria-hidden="true"> / </span>
        <span lang="hi">{hi.gate.heading}</span>
      </h1>

      <form class="gate__form" id="gate-form">
        <fieldset class="gate__options">
          <legend class="sr-only-focusable">Choose your language / भाषा चुनें</legend>

          <label class="gate__option" data-option>
            <input type="radio" name="locale" value="en" checked />
            <span class="gate__option-label" lang="en">{en.gate.english}</span>
          </label>

          <label class="gate__option" data-option>
            <input type="radio" name="locale" value="hi" />
            <span class="gate__option-label" lang="hi">{hi.gate.hindi}</span>
          </label>
        </fieldset>

        <button type="submit" class="btn btn-primary gate__continue">
          <span lang="en">{en.gate.continue}</span>
          <span aria-hidden="true"> · </span>
          <span lang="hi">{hi.gate.continue}</span>
        </button>
      </form>

      <p class="gate__hint">
        <span lang="en">{en.gate.hint}</span>
      </p>

      <noscript>
        <div class="gate__noscript">
          <a href={`${base}/en/home`} class="link">English</a>
          <span aria-hidden="true"> / </span>
          <a href={`${base}/hi/home`} class="link" lang="hi">हिन्दी</a>
        </div>
      </noscript>
    </div>

    <script is:inline define:vars={{ key: LOCALE_STORAGE_KEY, base, defaultLocale }}>
      (function () {
        var form = document.getElementById("gate-form");
        var backdrop = document.getElementById("gate-backdrop");
        var card = document.getElementById("gate-card");
        if (!form) return;

        function persistAndGo(loc) {
          try {
            localStorage.setItem(key, loc);
          } catch (e) {}
          document.cookie = key + "=" + loc + "; path=/; max-age=31536000; samesite=lax";
          location.href = base + "/" + loc + "/home";
        }

        var options = form.querySelectorAll("[data-option]");
        function refresh() {
          options.forEach(function (opt) {
            var input = opt.querySelector("input");
            opt.setAttribute("data-selected", input && input.checked ? "true" : "false");
          });
        }
        form.addEventListener("change", refresh);
        refresh();

        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var checked = form.querySelector('input[name="locale"]:checked');
          persistAndGo(checked ? checked.value : defaultLocale);
        });

        // Clicking the blurred site (anywhere outside the card) → English.
        if (backdrop) {
          backdrop.addEventListener("click", function () {
            persistAndGo("en");
          });
        }
        // Stop clicks inside the card from hitting the backdrop (card sits above).
        if (card) {
          card.addEventListener("click", function (e) {
            e.stopPropagation();
          });
        }
      })();
    </script>

    <style>
      .gate-body {
        margin: 0;
        min-height: 100svh;
        overflow: hidden;
        background: var(--ivory);
      }

      .gate-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1;
        cursor: pointer;
      }
      .gate-preview {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        pointer-events: none;
        transform: scale(1.02);
        transform-origin: top center;
        filter: blur(10px);
        opacity: 0.92;
      }
      .gate-scrim {
        position: absolute;
        inset: 0;
        background: color-mix(in srgb, var(--ink) 28%, transparent);
        pointer-events: none;
      }

      .gate-card {
        position: fixed;
        z-index: 2;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(calc(100% - 2rem), 26rem);
        padding: 1.75rem 1.5rem 1.5rem;
        text-align: center;
        background: var(--paper);
        border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
        border-radius: 6px;
        box-shadow:
          0 1px 2px color-mix(in srgb, var(--ink) 6%, transparent),
          0 24px 48px color-mix(in srgb, var(--ink) 18%, transparent);
      }
      .gate__logo {
        justify-content: center;
      }
      .gate__heading {
        margin-top: 1.25rem;
        font-size: clamp(1.25rem, 3.5vw, 1.65rem);
        font-weight: 500;
        line-height: 1.3;
      }
      .gate__heading-sep {
        color: var(--gold);
        font-weight: 400;
      }
      .gate__form {
        margin-top: 1.5rem;
      }
      .gate__options {
        border: 0;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.65rem;
        grid-template-columns: 1fr 1fr;
      }
      .gate__option {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.85rem 0.75rem;
        border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
        border-radius: 4px;
        background: var(--paper);
        cursor: pointer;
        transition: border-color 250ms ease, box-shadow 250ms ease;
      }
      .gate__option input {
        position: absolute;
        opacity: 0;
        inset: 0;
        cursor: pointer;
      }
      .gate__option[data-selected="true"] {
        border-color: var(--gold);
        box-shadow: inset 0 0 0 1px var(--gold);
      }
      .gate__option-label {
        font-size: 1rem;
      }
      .gate__continue {
        margin-top: 1rem;
        width: 100%;
      }
      .gate__hint {
        margin-top: 1rem;
        font-size: 0.875rem;
        color: var(--muted);
      }
      .gate__noscript {
        margin-top: 1rem;
      }
    </style>
  </body>
</html>
